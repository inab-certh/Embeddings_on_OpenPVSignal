ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2014_m_vemurafenib_pancreatitis_2014_2nd:literature_report X2014_m_vemurafenib_pancreatitis_2014_2nd:vemurafenib)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_pancreatitis_2014_2nd:literature_report X2014_m_vemurafenib_pancreatitis_2014_2nd:Ref.15)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_pancreatitis_2014_2nd:literature_report "There is one case report in the literature of a 49- year-old male with stage IV melanoma who developed pancreatitis two weeks after starting treatment with vemurafenib. He recovered following withdrawal of the drug, but pancreatitis recurred on rechallenge. His symptoms disappeared after permanent discontinuation of vemurafenib. All other possible causes were ruled out.15"^^xsd:string)

