ClassAssertion(OpenPVSignal:Free_text_reporting_element X2019_m_Gi_pain_2019_4rth:δ)
ObjectPropertyAssertion(mp:references X2019_m_Gi_pain_2019_4rth:δ X2019_m_Gi_pain_2019_4rth:Ref.4)
