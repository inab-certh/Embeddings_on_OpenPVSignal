# Individual: X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye (Dry eye pathobiology)

AnnotationAssertion(rdfs:label X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye "Dry eye pathobiology"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye X2019_m_Desloratadine_and_dry_eyes_2019_3rd:dryEyes)
ObjectPropertyAssertion(mp:references X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye X2019_m_Desloratadine_and_dry_eyes_2019_3rd:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Desloratadine_and_dry_eyes_2019_3rd:DryEye "Dry eye occurs when the surface of the eye is inadequately lubricated due to a decreased quantity and/or quality of tears.
Symptoms include itching, stinging or burning, excess tears following periods of dryness, pain, and redness in the eye. People with dry eyes may also experience blurred vision.2"^^xsd:string)

