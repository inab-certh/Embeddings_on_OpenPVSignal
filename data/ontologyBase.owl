AnnotationAssertion(rdfs:label X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents "Labelling for anti-VEGF agents"^^xsd:string)
ClassAssertion(OpenPVSignal:Structured_Product_Labels_information X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents)
ClassAssertion(OpenPVSignal:Warning_Information X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:gastrointestinalPerforation)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:aflibercept)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:bevacizumab)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:regorafenib)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:sorafenib)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Labelling_for_anti-VEGF_agents "Given its inhibitory effect on the VEGF receptor, the ADR profile for nintedanib can be considered analogous to other anti-angiogenic agents which antagonise VEGF (aflibercept, bevacizumab) or inhibit the VEGF-receptor (regorafenib, sorafenib). Indeed, the labels for all products contained harmonised wording regarding the risk of gastrointestinal perforation, and all also lack the inclusion of ischaemic colitis."^^xsd:string)

