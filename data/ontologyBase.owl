ObjectPropertyAssertion(OpenPVSignal:refers_to_signal X2015_m_Desloratadine_and_aggressive_reaction_6th:Desloratadine_and_aggressive_reaction X2015_m_Desloratadine_and_aggressive_reaction_6th:pvSignal)
