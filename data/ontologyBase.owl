# Individual: X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline (Mechanism of amitriptyline)

AnnotationAssertion(rdfs:label X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline "Mechanism of amitriptyline"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline X2017_m_amitriptyline_5th:anticholinergicEffects)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline X2017_m_amitriptyline_5th:dryEyes)
ObjectPropertyAssertion(mp:references X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline X2017_m_amitriptyline_5th:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_amitriptyline_5th:Mechanism_of_amitriptyline "It has anticholinergic effects, inhibiting the neurotransmitter acetylcholine present in the central and peripheral nervous systems. This inhibition has effects on several autonomous functions such as decreased saliva production, decreased mucus production in the nose and throat, decreased sweating, increased body temperature, dilation of the pupils and reduced bowel movements. As well as these effects, there is also the reduced production of tears, causing the eyes to feel dry"^^xsd:string)

