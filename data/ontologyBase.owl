ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_ivermectin_1st:Product_labelling_for_ivermectin X2018_ivermectin_1st:dizziness)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_ivermectin_1st:Product_labelling_for_ivermectin X2018_ivermectin_1st:dyspnoea)
