ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_finasterine_and_convulsions_4th:incidenceOfAcuteSymptomaticSeizures X2014_m_finasterine_and_convulsions_4th:seizure_disorder)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_finasterine_and_convulsions_4th:incidenceOfAcuteSymptomaticSeizures "29-39 per 100 000 per year"^^xsd:string)

