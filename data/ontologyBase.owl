ObjectPropertyAssertion(mp:references X2016_m_denosumab_vasculitis_6th:LercadipineAndSevelamerDoNotTriggerVasculitis X2016_m_denosumab_vasculitis_6th:Ref.6)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_vasculitis_6th:LercadipineAndSevelamerDoNotTriggerVasculitis X2016_m_denosumab_vasculitis_6th:Ref.7)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_denosumab_vasculitis_6th:LercadipineAndSevelamerDoNotTriggerVasculitis "Lercanidipine and sevelamer were co-suspected in the remaining case. The product literature for these two drugs do not refer to vasculitis "^^xsd:string)

# Individual: X2016_m_denosumab_vasculitis_6th:LiteratureAndLabelling (Literature and Labelling)

AnnotationAssertion(rdfs:label X2016_m_denosumab_vasculitis_6th:LiteratureAndLabelling "Literature and Labelling"^^xsd:string)
