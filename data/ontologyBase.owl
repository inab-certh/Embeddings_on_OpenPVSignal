ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2017_m_ruxolitinib_4th:Hydroxycarbamide_as_a_common_cause_of_peripheral_neuropathy X2017_m_ruxolitinib_4th:hydroxycarbamide)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:Hydroxycarbamide_as_a_common_cause_of_peripheral_neuropathy X2017_m_ruxolitinib_4th:Ref.7)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_ruxolitinib_4th:Hydroxycarbamide_as_a_common_cause_of_peripheral_neuropathy "A review of concomitant drugs identified three cases where drugs known to be a common cause of peripheral neuropathy were reported (hydroxycarbamide in two reports and tacrolimus in one).7,8"^^xsd:string)

# Individual: X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy (Immunomodulatory drugs and peripheran neuropathy)

AnnotationAssertion(rdfs:label X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy "Immunomodulatory drugs and peripheran neuropathy"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy X2017_m_ruxolitinib_4th:neuropathyPeripheral)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy X2017_m_ruxolitinib_4th:Immunosuppressants)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy X2017_m_ruxolitinib_4th:TNFaBlockers)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy X2017_m_ruxolitinib_4th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_ruxolitinib_4th:ImmunomodulatoryDrugsAndPeripheranNeuropathy "Of these 37 cases on ruxolitinib suspected to cause peripheral neuropathy in VigiBase, it is not possible to draw any conclusions regarding a possible mechanism, but it should be noted that other immunomodulatory drugs such as TNFα blocking molecules may cause peripheral neuropathy via demyelination. "^^xsd:string)

