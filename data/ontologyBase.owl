ObjectPropertyAssertion(mp:references X2013_m_abiraterone_6th_2013:IntroductionContent X2013_m_abiraterone_6th_2013:Ref.1)
ObjectPropertyAssertion(mp:references X2013_m_abiraterone_6th_2013:IntroductionContent X2013_m_abiraterone_6th_2013:Ref.10)
