ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:AcetylsalicylicAcid)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Dipyridamole)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.15)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.16)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.18)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.19)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.20)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena X2018_m_incosistent_labelling_4rth_2018:Ref.21)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena "The US label for the combination pill mentions an  “increased risk of bleeding” when using ASA and  extended-release dipyridamole.19 The UK SmPC for  the combination pill, on the contrary, says that the  addition of dipyridamole to ASA does not increase  the incidence of bleeding events, when these two  substances are combined.18  However, the UK SmPC for ASA (75 mg) mentions  that an increased risk of gastrointestinal bleeding is  present when concomitant anti-platelet agents such  as dipyridamole are used.20 Similarly, the US ASA label also mentions the increased risk when using  ASA with anti-coagulants, but no specific mention of  dipyridamole is described.15 The inconsistency is  strengthened when looking at the dipyridamole  labels: the US label does not mention the risk of  bleeding and the UK SmPC mentions that the  concomitant use with ASA does not increase the  risk of bleeding."^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_incosistent_labelling_4rth_2018:infoForAcetelysalicylicAcidAndDipyridamoleAndMelaena "The treatment with ASA and dipyridamole is available as a combination pill in the US and the EU for the secondary prevention of ischaemic stroke and for prophylaxis of thromboembolism associated with prosthetic heart valves. The combination treatment includes a small 25 mg dose of ASA with 200 mg of dipyridamole.18,19"^^xsd:string)

