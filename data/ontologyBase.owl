ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:leucopenia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:neutropenia)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.15)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.16)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.19)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.20)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.21)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE "Vemurafenib acts in the Ras-Raf-MEK-ERK MAPK pathway; this same pathway is involved in haematopoiesis, where it plays an important role in regulating myeloid, erythroid and megakaryocyte differentiation.15,16 It is therefore plausible that vemurafenib may have an effect on haematopoiesis."^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_2014_and_granulocytopenia_1st:proposedMechanismOfVemurafenibTriggeringTheAE "Vemurafenib is a potent and selective inhibitor of mutated B-Raf but it has also been shown to activate wild-type B-Raf (which is thought to account for the relatively common development of squamous cell carcinomas in patients treated with vemurafenib) and other intracellular signalling kinases.19,20,21 It is possible that vemurafenib may inhibit kinases that are involved in haematopoiesis resulting in granulocytopenia."^^xsd:string)

