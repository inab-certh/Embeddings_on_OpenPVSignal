DataPropertyAssertion(OpenPVSignal:has_content X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:interstitial_nephritis "Medicines known to induce interstitial nephritis are antimicrobials (e.g. cephalosporins, penicillins and sulphonamides), NSAIDs, diuretics and certain anticonvulsants (carbamazepine, phenytoin)."^^xsd:string)

