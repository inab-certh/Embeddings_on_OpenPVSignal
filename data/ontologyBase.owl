ObjectPropertyAssertion(OpenPVSignal:refers_to_author X2015_m_brentuximab_and_hepatic_disorders_2nd:Brentuximab_and_hepatic_disorders X2015_m_brentuximab_and_hepatic_disorders_2nd:Dr_Ruth_Savage)
