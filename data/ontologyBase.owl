ClassAssertion(OpenPVSignal:Warning_Information X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:AzorubinAndAllergicReactions)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:AzorubinAndAllergicReactions X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:allergicReaction)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:AzorubinAndAllergicReactions X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:azorubin)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:AzorubinAndAllergicReactions "the Irish SPC mentions allergic reactions to azorubin (E122) under precautions but lists only mild irritations of the buccal mucosa in the adverse reaction section"^^xsd:string)

