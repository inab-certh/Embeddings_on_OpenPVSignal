AnnotationAssertion(rdfs:label <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> "EURIDIS/ADONIS twin trial"^^xsd:string)
ClassAssertion(OpenPVSignal:Clinical_trial_information <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial>)
ObjectPropertyAssertion(OpenPVSignal:is_supported_by_statistical_entity <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#incidenceOfHyperthyroidismInEURIDIS/ADONIS-dronedaroneGroup>)
