ObjectPropertyAssertion(mp:references X2016_m_denosumab_and_lichen_planus_6th_2016:Lichen_planus_associated_with_a_variety_of_drugs X2016_m_denosumab_and_lichen_planus_6th_2016:Ref.3)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_and_lichen_planus_6th_2016:Lichen_planus_associated_with_a_variety_of_drugs X2016_m_denosumab_and_lichen_planus_6th_2016:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_denosumab_and_lichen_planus_6th_2016:Lichen_planus_associated_with_a_variety_of_drugs "Some LP-type rashes (often referred to as lichenoid reactions) occur as adverse reactions to a variety of drugs including nonsteroidal anti-inflammatory drugs, anti-hypertensives such as angiotensin converting enzyme inhibitors and beta-blockers, tetracyclines, sulfonamides, penicillamine, allopurinol, gold, antibiotics, arsenic, iodides, chloroquine, quinidine, phenothiazines, and diuretics.3,4"^^xsd:string)

# Individual: X2016_m_denosumab_and_lichen_planus_6th_2016:LiteratureAndLabelling (Literature and Labelling)

AnnotationAssertion(rdfs:label X2016_m_denosumab_and_lichen_planus_6th_2016:LiteratureAndLabelling "Literature and Labelling"^^xsd:string)
ClassAssertion(OpenPVSignal:Literature_information X2016_m_denosumab_and_lichen_planus_6th_2016:LiteratureAndLabelling)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_and_lichen_planus_6th_2016:LiteratureAndLabelling X2016_m_denosumab_and_lichen_planus_6th_2016:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_denosumab_and_lichen_planus_6th_2016:LiteratureAndLabelling "The product literature does not refer to LP but it notes that the skin reactions rash and eczema are common and that cases of cellulitis have been reported uncommonly.1 There are also no reports of LP in association with denosumab in the medical literature."^^xsd:string)

# Individual: X2016_m_denosumab_and_lichen_planus_6th_2016:MechanismOfDenosumab (Mechanism of denosumab)

AnnotationAssertion(rdfs:label X2016_m_denosumab_and_lichen_planus_6th_2016:MechanismOfDenosumab "Mechanism of denosumab"^^xsd:string)
ClassAssertion(OpenPVSignal:Mechanism X2016_m_denosumab_and_lichen_planus_6th_2016:MechanismOfDenosumab)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_and_lichen_planus_6th_2016:MechanismOfDenosumab X2016_m_denosumab_and_lichen_planus_6th_2016:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_denosumab_and_lichen_planus_6th_2016:MechanismOfDenosumab "Denosumab is a human monoclonal antibody (IgG2) that targets and binds with high affinity and specificity to the receptor activator of nuclear factor kappa-B ligand (RANKL), preventing activation of its receptor, RANK, on the surface of osteoclast precursors and osteoclasts.  Prevention of the RANKL/RANK interaction inhibits osteoclast formation, function and survival, thereby decreasing bone resorption in cortical and trabecular bone. "^^xsd:string)

