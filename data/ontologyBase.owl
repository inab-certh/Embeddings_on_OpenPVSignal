# Individual: X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo (reasons for poor adherence of patients to warning info)

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo "reasons for poor adherence of patients to warning info"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo)
ObjectPropertyAssertion(OpenPVSignal:is_part_of X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo X2018_m_brivudine_5fu_6th_2018:Discussion)
ObjectPropertyAssertion(mp:references X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo X2018_m_brivudine_5fu_6th_2018:Ref.10)
ObjectPropertyAssertion(mp:references X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo X2018_m_brivudine_5fu_6th_2018:Ref.11)
ObjectPropertyAssertion(mp:references X2018_m_brivudine_5fu_6th_2018:reasonsForPoorAdherenceOfPatientsToWarningInfo X2018_m_brivudine_5fu_6th_2018:Ref.12)
