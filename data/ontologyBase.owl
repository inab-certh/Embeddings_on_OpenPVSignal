ObjectPropertyAssertion(mp:references X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:introduction X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Ref.6)
