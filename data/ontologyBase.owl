ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2014_m_dronedarone_and_polyneuropathy_4th:internationalJournalOfCardiology X2014_m_dronedarone_and_polyneuropathy_4th:dronedarone)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_dronedarone_and_polyneuropathy_4th:internationalJournalOfCardiology "A further case report published in 2013 in the International Journal of Cardiology, concerns a 74- year-old man who developed optic neuropathy under dronedarone. While the pain subsided after discontinuation of dronedarone, the visual loss is is still persisting."^^xsd:string)

