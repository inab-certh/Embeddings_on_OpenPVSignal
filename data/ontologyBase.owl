# Class: OpenPVSignal:Adverse_Drug-Drug_interaction (Adverse Drug-Drug interaction)

AnnotationAssertion(rdfs:comment OpenPVSignal:Adverse_Drug-Drug_interaction "A negative response to a drug combination that may lead to unexpected side effects."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Adverse_Drug-Drug_interaction "Adverse Drug-Drug interaction"^^xsd:string)
SubClassOf(OpenPVSignal:Adverse_Drug-Drug_interaction OpenPVSignal:Adverse_Effect)
SubClassOf(OpenPVSignal:Adverse_Drug-Drug_interaction OpenPVSignal:Drug-Drug_interaction)

# Class: OpenPVSignal:Adverse_Effect (Adverse Effect)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Adverse_Effect "Note for Guidance on Clinical Safety Data Management:
Definitions and Standards for Expedited Reporting - http://www.ema.europa.eu/docs/en_GB/document_library/Scientific_guideline/2009/09/WC500002749.pdf -"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Adverse_Effect "Noxious and unintended response to a medicinal product."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Adverse_Effect "Adverse Effect"@en)
SubClassOf(OpenPVSignal:Adverse_Effect OpenPVSignal:Condition)

# Class: OpenPVSignal:Adverse_Effect_Mechanism (Adverse Effect Mechanism)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Adverse_Effect_Mechanism "Spratto, G.R.; Woods, A.L. (2010). Delmar Nurse's Drug Handbook. Cengage Learning. ISBN 978-1-4390-5616-5."^^xsd:string)
AnnotationAssertion(dc:title OpenPVSignal:Adverse_Effect_Mechanism "Adverse Effect Mechanism"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Adverse_Effect_Mechanism "A free-text description of the mechanism of action related with an adverse effect."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Adverse_Effect_Mechanism "Adverse Effect Mechanism"@en)
SubClassOf(OpenPVSignal:Adverse_Effect_Mechanism OpenPVSignal:Mechanism)

# Class: OpenPVSignal:Author (Author)

AnnotationAssertion(rdfs:comment OpenPVSignal:Author "The person or organization that wrote or was responsible for writing the respective PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Author "Author"@en)
SubClassOf(OpenPVSignal:Author OpenPVSignal:Free_text_reporting_element)
SubClassOf(OpenPVSignal:Author prov:Agent)
SubClassOf(OpenPVSignal:Author ObjectUnionOf(prov:Organization prov:Person))

# Class: OpenPVSignal:Bibliographic_reference (Bibliographic reference)

AnnotationAssertion(rdfs:comment OpenPVSignal:Bibliographic_reference "Reference to published material that is cited in the PV signal report (e.g. scientific paper, book, report etc.)"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Bibliographic_reference "Bibliographic reference"@en)
SubClassOf(OpenPVSignal:Bibliographic_reference OpenPVSignal:Free_text_reporting_element)
SubClassOf(OpenPVSignal:Bibliographic_reference mp:Reference)

# Class: OpenPVSignal:Case_Report_Information (Case Report Information)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Case_Report_Information "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3010033/"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Case_Report_Information "Description of the findings from case report publications which are mentioned in the PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Case_Report_Information "Case Report Information"@en)
SubClassOf(OpenPVSignal:Case_Report_Information OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Clinical_trial_information (Clinical Trial Information)

AnnotationAssertion(rdfs:comment OpenPVSignal:Clinical_trial_information "Description of the findings from clinical trials which are mentioned in the PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Clinical_trial_information "Clinical Trial Information"@en)
SubClassOf(OpenPVSignal:Clinical_trial_information OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Cohort_Profile (Cohort Profile)

AnnotationAssertion(rdfs:comment OpenPVSignal:Cohort_Profile "Characteristics of a Cohort study group"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Cohort_Profile "Cohort Profile"^^xsd:string)
SubClassOf(OpenPVSignal:Cohort_Profile obo:OAE_0000127)
SubClassOf(OpenPVSignal:Cohort_Profile mp:Data)

# Class: OpenPVSignal:Conclusion (Conclusion)

AnnotationAssertion(rdfs:comment OpenPVSignal:Conclusion "The free-text description of the main outcome of the PV signal report."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Conclusion "Conclusion"^^xsd:string)
SubClassOf(OpenPVSignal:Conclusion OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Condition (Condition)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Condition "https://meshb.nlm.nih.gov/record/ui?ui=D004194"^^xsd:string)
AnnotationAssertion(oboInOwl:hasBroadSynonym OpenPVSignal:Condition "Disease"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Condition "A definite pathologic process with a characteristic set of signs and symptoms. It may affect the whole body or any of its parts, and its etiology, pathology, and prognosis may be known or unknown."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Condition "Condition"@en)

# Class: OpenPVSignal:Confidence_interval_0.95 (Confidence Interval 0.95)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Confidence_interval_0.95 "Based on the https://www.investopedia.com/terms/c/confidenceinterval.asp"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Confidence_interval_0.95 "The marginal values of the range in which the respective statistical measure (e.g. PRR or ROR) belongs with a propability of 95%."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Confidence_interval_0.95 "Confidence Interval 0.95"^^xsd:string)
SubClassOf(OpenPVSignal:Confidence_interval_0.95 OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Discussion (Discussion)

AnnotationAssertion(rdfs:comment OpenPVSignal:Discussion "The signal section that discusses the findings."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Discussion "Discussion"^^xsd:string)
SubClassOf(OpenPVSignal:Discussion OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Disproportionality_Analysis_Measure (Disproportionality Analysis Measure)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Disproportionality_Analysis_Measure "https://www.jmp.com/content/dam/jmp/documents/en/white-papers/disproportionality-105686.pdf"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Disproportionality_Analysis_Measure "Statistical feature depicting the comparison between the rate at which a particular event of interest (e.g. adverse effect) co-occurs with a given drug, and the rate of this event occuring without the drug."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Disproportionality_Analysis_Measure "Disproportionality Analysis Measure"@en)
SubClassOf(OpenPVSignal:Disproportionality_Analysis_Measure OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Dosage (Dosage)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Dosage "http://www.medlinguistics.com/didyouknow.asp"^^xsd:string)
AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Dosage "https://www.verywell.com/drug-dose-definition-and-examples-1123989"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Dosage "The regulated administration of individual doses, the quantity of drug to be administered at one time, or the total quantity administered during a specified period, i.e. the dosage not only tells the quantity of medicine to be taken, but it also tells the frequency or the number of times a medicine has to be taken by the patient."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Dosage "Dosage"^^rdfs:Literal)

# Class: OpenPVSignal:Drug (Drug)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Drug "The Need for Definitions in Pharmacovigilance Marie Lindquist - https://www.ncbi.nlm.nih.gov/pubmed/17867720"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Drug "Product intended to be administered to humans for treating or preventing disease, with the view to making a medical diagnosis or to restore, correct or modify physiological functions"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug "Drug"@en)
SubClassOf(OpenPVSignal:Drug obo:OBI_0000047)

# Class: OpenPVSignal:Drug-Drug_interaction (Drug-Drug interaction)

AnnotationAssertion(rdfs:comment OpenPVSignal:Drug-Drug_interaction "The effect of a drug combination. Can be either positive or detrimental."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug-Drug_interaction "Drug-Drug interaction"^^xsd:string)

# Class: OpenPVSignal:DrugClass (Drug Class)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:DrugClass "https://en.wikipedia.org/wiki/Drug_class"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:DrugClass "A set of medications that have similar chemical structures, the same mechanism of action (i.e., bind to the same biological target), a related mode of action, and/or are used to treat the same disease."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:DrugClass "Drug Class"^^xsd:string)

# Class: OpenPVSignal:Drug_Class_Effect_Information (Drug Class Effect Information)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Drug_Class_Effect_Information "Free text information regarding the administration of drugs with similar structure and mechanism of action (i.e. they belong to the same class) as described in the PV signal report."^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Drug_Class_Effect_Information "Free text information regarding the effect of the drugs belonging to a specific drug class."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug_Class_Effect_Information "Drug Class Effect Information"@en)
SubClassOf(OpenPVSignal:Drug_Class_Effect_Information OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Drug_Exposure_Time (Drug Exposure Time)

AnnotationAssertion(rdfs:comment OpenPVSignal:Drug_Exposure_Time "The time related information regarding the administration of a drug to a patient (e.g. when it started and when it ended)."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug_Exposure_Time "Drug Exposure Time"@en)

# Class: OpenPVSignal:Drug_Intake_Form (Drug Intake Form)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Drug_Intake_Form "https://en.wikipedia.org/wiki/Dosage_form"^^xsd:string)
AnnotationAssertion(oboInOwl:hasBroadSynonym OpenPVSignal:Drug_Intake_Form "Administration Route"^^xsd:string)
AnnotationAssertion(oboInOwl:hasBroadSynonym OpenPVSignal:Drug_Intake_Form "Dosage Form"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Drug_Intake_Form "The form of the drug taken by the patient (e.g. injection, pill etc.)."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug_Intake_Form "Drug Intake Form"@en)

# Class: OpenPVSignal:Drug_Usage (Drug Usage)

AnnotationAssertion(rdfs:comment OpenPVSignal:Drug_Usage "The details of an overall drug administration process (e.g. exposure, intake form, dosage)."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Drug_Usage "Drug Usage"^^xsd:string)

# Class: OpenPVSignal:Free_text_reporting_element (Free text reporting element)

SubClassOf(OpenPVSignal:Free_text_reporting_element mp:ArticleText)

# Class: OpenPVSignal:Incidence (Incidence)

AnnotationAssertion(rdfs:comment OpenPVSignal:Incidence "Refers to the occurrence of new cases of disease or injury in a population over a specified period of time"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Incidence "Incidence"^^xsd:string)
SubClassOf(OpenPVSignal:Incidence OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Indication (Indication)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Indication "https://www.medicinenet.com/script/main/art.asp?articlekey=32545"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Indication "A medical condition which makes a particular treatment or procedure advisable"@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Indication "Indication"^^xsd:string)

# Class: OpenPVSignal:Individual_Case_Safety_Report (Individual Case Safety Report)

AnnotationAssertion(oboInOwl:hasBroadSynonym OpenPVSignal:Individual_Case_Safety_Report "Individual Case Report"^^xsd:string)
AnnotationAssertion(oboInOwl:hasExactSynonym OpenPVSignal:Individual_Case_Safety_Report "Spontaneous Report"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Individual_Case_Safety_Report "A report triggered by a suspicion of a healthcare professional or a patient that observed signs and symptoms could have been caused by a medicine."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Individual_Case_Safety_Report "Individual Case Safety Report"@en)
SubClassOf(OpenPVSignal:Individual_Case_Safety_Report obo:OAE_0000127)
SubClassOf(OpenPVSignal:Individual_Case_Safety_Report mp:Data)

# Class: OpenPVSignal:Introduction (Introduction)

AnnotationAssertion(rdfs:comment OpenPVSignal:Introduction "The initial part of a PV signal report, typically providing contextual information about the signal."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Introduction "Introduction"@en)
SubClassOf(OpenPVSignal:Introduction OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Lareb_Report (Lareb Report)

AnnotationAssertion(rdfs:comment OpenPVSignal:Lareb_Report "An Individual Case Safety Report submitted in the Dutch spontaneous report system maintained by Lareb."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Lareb_Report "Lareb Report"^^xsd:string)
SubClassOf(OpenPVSignal:Lareb_Report OpenPVSignal:Individual_Case_Safety_Report)

# Class: OpenPVSignal:Literature_information (Literature Information)

AnnotationAssertion(rdfs:comment OpenPVSignal:Literature_information "Description of the findings in scientific literature as contained in the PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Literature_information "Literature Information"@en)
SubClassOf(OpenPVSignal:Literature_information OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Mechanism (Mechanism)

AnnotationAssertion(rdfs:comment OpenPVSignal:Mechanism "A free-text description of a drug's mechanism of action, as described in the PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Mechanism "Mechanism"@en)
SubClassOf(OpenPVSignal:Mechanism OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Medication_Errors (Medication errors)

AnnotationAssertion(obo:OAE_0004334 OpenPVSignal:Medication_Errors "20000224"^^xsd:integer)
AnnotationAssertion(rdfs:comment OpenPVSignal:Medication_Errors "Medication errors are defined as any preventable events that may cause or lead to inappropriate medication use or patient harm while the medication is in the control of the health care professional, patient or consumer. Such events may be related to professional practice, health care products, procedures and systems, including prescribing, order communication, product labeling, packaging and nomenclature, compounding, dispensing, distribution, administration, education, monitoring and use. A medication error can ultimately result in an adverse drug reaction (medication error with an ADR) or may have no clinical consequences (medication error without an ADR). A medication error can also be intercepted prior to the patient's exposure to the error. A potential medication error is a scenario which does not involve an actual patient, and represents circumstances or information capable of leading to the occurrence of a medication error. Medication errors cause a large number of ADRs annually: create a major public-health burden representing 18.7-56% of all adverse drug events among hospital patients; may cause unintended harm; are considered preventable. Medication errors result from a variety of human (e.g., healthcare professional; care giver; patient) and product-related reasons, for example: miscommunication of drug orders due to poor handwriting; confusion between drugs with similar names; poor packaging design; confusion of dosing units; unclear instructions. Medication errors can have an impact on: patients; healthcare professionals; pharmaceutical manufacturers; regulatory agencies; health insurance providers; national patient safety organisations"^^xsd:string)
AnnotationAssertion(rdfs:isDefinedBy OpenPVSignal:Medication_Errors "http://purl.bioontology.org/ontology/MEDDRA/20000224"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Medication_Errors "Medication errors"^^xsd:string)

# Class: OpenPVSignal:Number_of_prescriptions_on_population (Number of prescriptions on population)

AnnotationAssertion(rdfs:comment OpenPVSignal:Number_of_prescriptions_on_population "The count of the specific drug prescriptions on a population basis."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Number_of_prescriptions_on_population "Number of prescriptions on population"@en)
SubClassOf(OpenPVSignal:Number_of_prescriptions_on_population OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Past_Diagnosis (Past Diagnosis)

AnnotationAssertion(rdfs:comment OpenPVSignal:Past_Diagnosis "Previous diagnosis of conditions"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Past_Diagnosis "Past Diagnosis"^^xsd:string)
SubClassOf(OpenPVSignal:Past_Diagnosis OpenPVSignal:Condition)

# Class: OpenPVSignal:Patient (Patient)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Patient "The Need for Definitions in Pharmacovigilance Marie Lindquist - https://www.ncbi.nlm.nih.gov/pubmed/17867720"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Patient "Person awaiting or under medical care or treatment by a health professional"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Patient "Patient"@en)
SubClassOf(OpenPVSignal:Patient prov:Person)

# Class: OpenPVSignal:Pharmacovigilance_Signal_Report (Pharmacovigilance Signal Report)

AnnotationAssertion(rdfs:comment OpenPVSignal:Pharmacovigilance_Signal_Report "Free text reports published by PV monitoring organizations regarding a PV signal. Examples include reports published by FDA, WHO-UMC and Lareb."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Pharmacovigilance_Signal_Report "Pharmacovigilance Signal Report"@en)
SubClassOf(OpenPVSignal:Pharmacovigilance_Signal_Report mp:Micropublication)

# Class: OpenPVSignal:Potential_Confounder (Potential Confounder)

AnnotationAssertion(rdfs:comment OpenPVSignal:Potential_Confounder "Confounders are factors other than the exposure/intervention that may affect the outcome of interest and that can be related to exposure/intervention."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Potential_Confounder "Potential Confounder"^^xsd:string)

# Class: OpenPVSignal:Prevalence (Prevalence)

AnnotationAssertion(rdfs:comment OpenPVSignal:Prevalence "The proportion of persons in a population who have a particular disease or attribute"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Prevalence "Prevalence"^^xsd:string)
SubClassOf(OpenPVSignal:Prevalence OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Relative_Reporting_Ratio (Relative Reporting Ratio (RRR))

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Relative_Reporting_Ratio "http://openvigil.sourceforge.net/doc/DPA.pdf"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Relative_Reporting_Ratio "Depicts the observed frequency of the adverse event to expected frequency in the total population sample."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Relative_Reporting_Ratio "Relative Reporting Ratio (RRR)"@en)
SubClassOf(OpenPVSignal:Relative_Reporting_Ratio OpenPVSignal:Disproportionality_Analysis_Measure)

# Class: OpenPVSignal:Reporting_Odds_Ratio (Reporting Odds Ratio (ROR))

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Reporting_Odds_Ratio "The Need for Definitions in Pharmacovigilance Marie Lindquist - https://www.ncbi.nlm.nih.gov/pubmed/17867720"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Reporting_Odds_Ratio "The Odds of exposure (to a Medicinal product ) in cases (e.g. individuals with an Adverse reaction) divided by the Odds of exposure in controls (e.g. individuals without the Adverse reaction)."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Reporting_Odds_Ratio "Reporting Odds Ratio (ROR)"@en)
SubClassOf(OpenPVSignal:Reporting_Odds_Ratio OpenPVSignal:Disproportionality_Analysis_Measure)

# Class: OpenPVSignal:Reports_group (Reports group)

AnnotationAssertion(rdfs:comment OpenPVSignal:Reports_group "A set of Individual Case Safety Reports corresponding to specific criteria (e.g. country of origin)."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Reports_group "Reports group"^^xsd:string)
SubClassOf(OpenPVSignal:Reports_group OpenPVSignal:Statistical_Entity)

# Class: OpenPVSignal:Response_to_Pharmacovigilance_Signal_Report (Response to Pharmacovigilance Signal Report)

AnnotationAssertion(rdfs:comment OpenPVSignal:Response_to_Pharmacovigilance_Signal_Report "Arguments to the claims of a PV signal report, as contained in the PV signal report itself in free-text format. Typically, such a response would be issued by a pharmaceutical company producing the investigated drug."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Response_to_Pharmacovigilance_Signal_Report "Response to Pharmacovigilance Signal Report"@en)
SubClassOf(OpenPVSignal:Response_to_Pharmacovigilance_Signal_Report OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Signal (Signal)

AnnotationAssertion(obo:IAO_0000119 OpenPVSignal:Signal "Council for International Organisations of Medical Sciences Working
group VIII, Practical Aspects of Signal Detection in Pharmacovigilance
(CIOMS, Geneva 2010)"^^xsd:string)
AnnotationAssertion(rdfs:comment OpenPVSignal:Signal "Information that arises from one or multiple sources (including observations and experiments), which suggests a new potentially causal association, or a new aspect of a known association, between an intervention and an event or set of related events, either adverse or beneficial, that is judged to be of sufficient likelihood to justify verificatory action."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Signal "Signal"@en)
SubClassOf(OpenPVSignal:Signal mp:Claim)

# Class: OpenPVSignal:Statistical_Entity (Statistical Entity)

AnnotationAssertion(rdfs:comment OpenPVSignal:Statistical_Entity "Concepts that depict the result of the calculation of specific statistical processes (e.g. disproportionality analysis)"@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Statistical_Entity "Statistical Entity"@en)
SubClassOf(OpenPVSignal:Statistical_Entity mp:Data)

# Class: OpenPVSignal:Structured_Product_Labels_information (Structured Product Labels information)

AnnotationAssertion(rdfs:comment OpenPVSignal:Structured_Product_Labels_information "Free-text description of information elaborated the leaflet which is typically part of the drug's packaging (a.k.a Structured Product Label, or Summary of Product Characteristics - SmPC), as contained in the PV signal report."@en)
AnnotationAssertion(rdfs:label OpenPVSignal:Structured_Product_Labels_information "Structured Product Labels information"@en)
SubClassOf(OpenPVSignal:Structured_Product_Labels_information OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Summary (Summary)

AnnotationAssertion(rdfs:comment OpenPVSignal:Summary "The free text summary of a pharmacovigilance signal report"^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Summary "Summary"@en)
SubClassOf(OpenPVSignal:Summary OpenPVSignal:Free_text_reporting_element)

# Class: OpenPVSignal:Vaccine (Vaccine)

AnnotationAssertion(rdfs:comment OpenPVSignal:Vaccine "A vaccine is a processed material with the function that when administered, it prevents or ameliorates a disorder in a target organism by inducing or modifying adaptive immune responses specific to the antigens in the vaccine."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:Vaccine "Vaccine"^^xsd:string)
SubClassOf(OpenPVSignal:Vaccine OpenPVSignal:Drug)

# Class: OpenPVSignal:VigiBase_Report (VigiBase report)

