ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2015_m_linagliptin_cardiac_failure_1st_2015:SaxagliptinClinicalTrial X2015_m_linagliptin_cardiac_failure_1st_2015:saxagliptin)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:SaxagliptinClinicalTrial X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.11)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:SaxagliptinClinicalTrial X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.24)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:SaxagliptinClinicalTrial "A large trial found a higher statistically significant risk of hospitalization due to HF in the saxagliptin group than in the placebo group. Patients had T2DM and established cardiovascular disease or multiple cardiovascular risks factors,and were followed for a median of
2.1 years; HF was included in a composite secondary endpoint. 12.8% of participants had prior HF.11 The events were more frequent in patients with diabetes and HF.24"^^xsd:string)

