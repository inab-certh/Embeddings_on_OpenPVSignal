ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_panic_attack <http://purl.org/OpenPVSignal/Signals/2018_5_Desogestrel_severe_psychiatric_disorders.owl#ethinylestradiol/norgestimate>)
ObjectPropertyAssertion(mp:references X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_panic_attack X2018_m_desogestrel_2018_5th:Ref.6)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_panic_attack "Widening the search to look at all hormonal contraceptives for systemic use (ATC G03A) and the PT 'panic attack' in VigiBase revealed that with several other contraceptives panic attacks were also reported more often than expected compared to the background of the database (i.e. had positive IC025 values; IC025 being the 95% credibility interval for the information component that describes disproportionate reporting in VigiBase6 ). These were drospirenone/ethinylestradiol, ethinylestradiol/etonogestrel, ethinylestradiol/iron/ norethisterone, norethisterone, levonorgestrel and ethinylestradiol/norgestimate."^^xsd:string)

# Individual: X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation (Positive IC025 hormonal contraceptives and suicidal ideation)

AnnotationAssertion(rdfs:label X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation "Positive IC025 hormonal contraceptives and suicidal ideation"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:SuicidalIdeation)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:self-injuriousBehavior)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:Hormonal_Contraceptives_for_Systemic_use)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:Desogestrel)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:norethindrone)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation X2018_m_desogestrel_2018_5th:norethindrone-ethinyl_estradiol-iron)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_desogestrel_2018_5th:Positive_IC025_hormonal_contraceptives_and_suicidal_ideation "An overview of the HLT 'suicidal and self-injurious behaviour' for all systemic hormonal contraceptives in VigiBase showed that desogestrel is one out of three drugs that is reported more often than expected compared to the rest of the database (with a 95% credibility interval: IC025 1.19). The two other drugs both contain norethisterone; the combined oral contraceptive norethisterone acetate/ethinylestradiol/ferrous fumarate and norethisterone alone."^^xsd:string)

