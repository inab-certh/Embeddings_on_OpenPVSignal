ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:Mechanism_of_pioglitazone_for_HF X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.21)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:Mechanism_of_pioglitazone_for_HF "Fluid retention, that can cause or exacerbate HF in some patients, is a known effect of PPAR-γ, and pioglitazone can cause or exacerbate congestive HF in some patients.21"^^xsd:string)

