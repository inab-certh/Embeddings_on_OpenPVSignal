ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Not_mentionig_ADRs_for_desogestrel X2018_m_desogestrel_2018_5th:Desogestrel)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_desogestrel_2018_5th:Not_mentionig_ADRs_for_desogestrel "However, the much more severe 'panic attack', 'suicidal ideation' and 'self-injurious behaviour' are not mentioned at all and nothing relevant was found in a PubMed search for desogestrel related to these terms."^^xsd:string)

