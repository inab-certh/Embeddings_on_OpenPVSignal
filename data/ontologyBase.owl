# Individual: X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents (overview of antithrombotic agents)

AnnotationAssertion(rdfs:label X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents "overview of antithrombotic agents"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents X2019_m_xa_factor_2019_3rd:haematospermia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents X2019_m_xa_factor_2019_3rd:acetylsalicylicAcid)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents X2019_m_xa_factor_2019_3rd:clopidogrel)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents X2019_m_xa_factor_2019_3rd:ticagrelor)
ObjectPropertyAssertion(mp:references X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents X2019_m_xa_factor_2019_3rd:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_xa_factor_2019_3rd:overview_of_antithrombotic_agents "An overview of antithrombotic agents (anticoagulants and antiplatelet agents) in VigiBase showed that, as for the oral Factor Xa inhibitors, haematospermia with the antiplatelet agents aspirin, ticagrelor and clopidogrel was also reported more often than expected and highlighted by the IC values. Patients contributed 33 to 57% of these reports. There is a published case report of clopidogrel and haematospermia with recurrence on rechallenge.5"^^xsd:string)

