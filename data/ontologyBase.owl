ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2015_m_Desloratadine_and_aggressive_reaction_6th:crossing_the_blood_brain_barrier X2015_m_Desloratadine_and_aggressive_reaction_6th:desloratadine)
ObjectPropertyAssertion(mp:references X2015_m_Desloratadine_and_aggressive_reaction_6th:crossing_the_blood_brain_barrier X2015_m_Desloratadine_and_aggressive_reaction_6th:Ref.1)
ObjectPropertyAssertion(mp:references X2015_m_Desloratadine_and_aggressive_reaction_6th:crossing_the_blood_brain_barrier X2015_m_Desloratadine_and_aggressive_reaction_6th:Ref.16)
ObjectPropertyAssertion(mp:references X2015_m_Desloratadine_and_aggressive_reaction_6th:crossing_the_blood_brain_barrier X2015_m_Desloratadine_and_aggressive_reaction_6th:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_Desloratadine_and_aggressive_reaction_6th:crossing_the_blood_brain_barrier "Although desloratadine is said not to readily cross 
the blood-brain barrier, this cannot be completely 
excluded and there have been reports of CNS 
adverse reactions from this drug.1,2,16 One 
example is emotional lability, which may in a wider 
sense include the term discussed in this signal, 
found to be reported at greater frequency for 
desloratadine than for placebo in infants and 
toddlers.2"^^xsd:string)

