ObjectPropertyAssertion(OpenPVSignal:is_supported_by_statistical_entity X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:DIONISOSTrial X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:differenceBetweenADRIncidencesOfDronedaroneAndAmiodarone)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:DIONISOSTrial X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:amiodarone)
