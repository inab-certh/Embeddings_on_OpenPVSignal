AnnotationAssertion(rdfs:label X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Mechanism_of_Omalizumab "Mechanism of Omalizumab"^^xsd:string)
ClassAssertion(OpenPVSignal:Mechanism X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Mechanism_of_Omalizumab)
ObjectPropertyAssertion(OpenPVSignal:is_part_of X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Mechanism_of_Omalizumab X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:introduction)
ObjectPropertyAssertion(mp:references X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Mechanism_of_Omalizumab X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Mechanism_of_Omalizumab "Omalizumab is a recombinant humanized anti-IgE antibody that inhibits the activity of IgE, thus preventing the binding of IgE to high-affinity IgE receptor (FcεRI) on the surface of mast cells and basophils. The reductions in surface bound IgE on FcεRI bearing cells limits the release of mediators of the allergic response."^^xsd:string)

