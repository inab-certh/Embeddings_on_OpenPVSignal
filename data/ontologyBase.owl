ObjectPropertyAssertion(mp:references X2017_m_sglt2_inhibitors_3rd:No_causality_established_by_prior_clinical_trials_for_SGLT2_and_genital_infections X2017_m_sglt2_inhibitors_3rd:Ref.2)
