# Individual: X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia (Possible mechanism of atomoxetine-induced dystonia)

AnnotationAssertion(rdfs:label X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia "Possible mechanism of atomoxetine-induced dystonia"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:dystonia)
ObjectPropertyAssertion(mp:references X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:PossibleMechanismOfatomoxetine-inducedDystonia "The pathophysiological mechanisms underlying acute extrapyramidal symptoms such as dystonia are usually attributed to the effects of dopamine receptor blockade in the basal ganglia.4 As atomoxetine is a weak inhibitor of dopamine uptake, it is possible that this may be the basis of a possible mechanism."^^xsd:string)

