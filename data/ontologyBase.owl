DataPropertyAssertion(OpenPVSignal:has_affiliation X2018_m_ciprofloxacin_1st_2018:Dr_Ruth_Savage "Upsalla Monitoring Centre"^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_first_name X2018_m_ciprofloxacin_1st_2018:Dr_Ruth_Savage "Ruth"^^xsd:string)
