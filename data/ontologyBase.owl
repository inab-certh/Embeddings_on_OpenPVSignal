ObjectPropertyAssertion(OpenPVSignal:refers_to_interval_between_administrations X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Dosage_of_omalizumab <http://purl.org/OpenPVSignal/Signals/2019_1_omalizumab_anaphylactic_shock.owl#4_weeks_intervals>)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Dosage_of_omalizumab "The dose applied for is 150 – 375 mg subcutaneously, every two or four weeks, depending on the baseline serum total IgE level, measured before the start of the treatment, and body weight."^^xsd:string)
