ClassAssertion(OpenPVSignal:Literature_information X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Literature_and_Labelling)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Literature_and_Labelling X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.2)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Literature_and_Labelling X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.3)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Literature_and_Labelling "Gynaecomastia is stated as an adverse reaction for esomeprazole in both the United States (US) Food and Drug Administration (FDA) label and in the United Kingdom (UK) Summary of Product Characteristics (SmPC). However, obesity is not described as a risk group for this drug-induced gynaecomastia in either source.2,3"^^xsd:string)

# Individual: X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Mechanism_of_esomeprazole (Mechanism of esomeprazole)

AnnotationAssertion(rdfs:label X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Mechanism_of_esomeprazole "Mechanism of esomeprazole"^^xsd:string)
ClassAssertion(OpenPVSignal:Mechanism X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Mechanism_of_esomeprazole)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Mechanism_of_esomeprazole X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Mechanism_of_esomeprazole "Esomeprazole is a proton-pump inhibitor used to treat gastroesophageal reflux disease (GERD), helicobacter pylori-associated ulcers in combination with antibiotics, as well as to treat and prevent NSAID-associated ulcers. It acts by inhibiting the enzyme H+K+-ATPase and thus inhibits both basal and stimulated acid secretion"^^xsd:string)

