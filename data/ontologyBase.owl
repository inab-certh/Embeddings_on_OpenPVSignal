# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_1_info (case 1 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_1_info "case 1 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_1_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_1_info "Increased enzymes x 3-6 ULN after each administration, polyneuropathy worsened after each dose.
Stopped after 4th dose and recovered from both increased hepatic enzymes and polyneuropathy."^^xsd:string)

# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_2_info (case 2 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_2_info "case 2 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_2_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_2_info "Liver function tests normal pre 1st dose. ALT and AST increased then improved prior to 2nd dose. Approximately two weeks after 2nd dose bilirubin increased then admission for fever, weakness, abnormal liver function tests. Liver biopsy reported as non-specific, probably drug-induced Mild hepatic steatosis, mildly increased iron stores, scattered inflammatory cells"^^xsd:string)

# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_3_info (case 3 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_3_info "case 3 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_3_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_3_info "Enzymes increased x 2-3 ULN 10-15 days after each administration"^^xsd:string)

# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_4_info (case 4 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_4_info "case 4 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_4_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_4_info "Liver biopsy showed no GvHD but “potential drug reaction”"^^xsd:string)

# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_5_info (case 5 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_5_info "case 5 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_5_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_5_info "Transaminases increased and abdominal pain, then diarrhoea and bilirubin inreased. Two days after 2nd dose developed fulminant hepatitis. No previous hepatic abnormalities despite stem cell transplant, chemotherapy and fluconazole. Aciclovir, fluconazole, prednisone for neoplasm prophylaxis. Vitamin 
K for INR 1.3 to 1.4 with no evidence of liver disease."^^xsd:string)

# Individual: X2015_m_brentuximab_and_hepatic_disorders_2nd:case_6_info (case 6 info)

AnnotationAssertion(rdfs:label X2015_m_brentuximab_and_hepatic_disorders_2nd:case_6_info "case 6 info"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_brentuximab_and_hepatic_disorders_2nd:case_6_info)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_brentuximab_and_hepatic_disorders_2nd:case_6_info "Mild cholestatasis since day of 1st dose, more pronounced after seven days, more severe after 2nd infusion (3 weeks after 1st)
Viral serology negative."^^xsd:string)

