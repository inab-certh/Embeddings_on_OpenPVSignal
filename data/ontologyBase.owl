ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_pazopanib_and_pericardial_effusion:Warning_on_the_possibility_of_cardiac_dysfunction X2013_m_pazopanib_and_pericardial_effusion:cardiacDysfunction)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_pazopanib_and_pericardial_effusion:Warning_on_the_possibility_of_cardiac_dysfunction X2013_m_pazopanib_and_pericardial_effusion:congestiveHeartFailure)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_pazopanib_and_pericardial_effusion:Warning_on_the_possibility_of_cardiac_dysfunction X2013_m_pazopanib_and_pericardial_effusion:leftVentricularDysfunction)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2013_m_pazopanib_and_pericardial_effusion:Warning_on_the_possibility_of_cardiac_dysfunction X2013_m_pazopanib_and_pericardial_effusion:pazopanib)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_pazopanib_and_pericardial_effusion:Warning_on_the_possibility_of_cardiac_dysfunction "There is a warning on the possibility of cardiac dysfunction such as congestive heart failure and decreased left ventricular function. Such cardiac dysfunction could result in the development of pericardial effusion but as none of the reports document these other cardiac reactions, this does not appear to be a cause."^^xsd:string)

