ObjectPropertyAssertion(OpenPVSignal:refers_to_drug <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:dronedarone)
ObjectPropertyAssertion(mp:references <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> X2012_m_Dronedarone_hyperthyroidism_decreased_TSH_4th:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> "In the EURIDIS, ADONIS twin studies of 612 and 625 subjects taking dronedarone 800 mg daily or placebo over one year, the incidence of hyperthyroidism was 8.4% in subjects taking dronedarone and 14.1% in those assigned to placebo. In these twin studies, hyperthyroidism was defined as a free T3 level or free T4 level above the normal range or a thyrotropin (TSH) level below the normal range. The severity of these changes and whether they were clinically important was not described."^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_reporter_type <http://purl.org/OpenPVSignal/Signals/2012_5_dronedarone_hyperthyroidism_decreased_thyroid_stimulating_hormone#EURIDIS/ADONISTwinTrial> "clinical trial report"^^xsd:string)

