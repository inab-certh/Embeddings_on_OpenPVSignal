ClassAssertion(OpenPVSignal:Mechanism X2015_m_linagliptin_cardiac_failure_1st_2015:Mechanism_of_pioglitazone)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:Mechanism_of_pioglitazone X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.21)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:Mechanism_of_pioglitazone "Pioglitazone is a thiazolidinedione, which selectively ligands the nuclear transcription factor peroxisome proliferator-activated receptor-γ (PPAR-γ). Thiazolidinediones improve glycaemic control by increasing insulin sensitivity."^^xsd:string)

