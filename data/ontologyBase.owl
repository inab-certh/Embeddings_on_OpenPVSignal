# Individual: X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials (meta analysis of 50 DPPis trials)

AnnotationAssertion(rdfs:label X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials "meta analysis of 50 DPPis trials"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials)
ClassAssertion(OpenPVSignal:Clinical_trial_information X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials X2015_m_linagliptin_cardiac_failure_1st_2015:heartFailure)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials X2015_m_linagliptin_cardiac_failure_1st_2015:DDP4_inhibitors)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.16)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_of_50_DPPis_trials "A meta-analysis of 50 DPP4-inhibitors trials, enrolling 55,141 participants, found a statistically significant trend towards increased risk of HF outcomes with no increase in risk with regards to all-cause mortality, cardiovascular mortality, acute coronary syndrome (ACS) or stroke. Most of the HF cases were retrieved from results of SAVOR-TIMI-53 (saxagliptin, 66.2% of the data of HF), EXAMINE (alogliptin, 21.3%) and the VIVIDD trial (vildagliptin, 6.9%), the latter enrolled only patients with left ventricular fraction <40%. Seven clinical trials for linagliptin with 5,260 participants were included in the analysis.16"^^xsd:string)

# Individual: X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk (meta analysis showing lower risk)

AnnotationAssertion(rdfs:label X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk "meta analysis showing lower risk"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk X2015_m_linagliptin_cardiac_failure_1st_2015:DDP4_inhibitors)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.13)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:meta_analysis_showing_lower_risk "A meta-analysis, published in February 2013, found that treatment with DPP4i reduces the risk of cardiovascular events (particularly myocardial infarction) and all-cause mortality in patients with type 2 diabetes. Although HF was a pre-specified component of major cardiovascular events (MACE), meta-analysis’s results don’t mention HF.13"^^xsd:string)

