DataPropertyAssertion(OpenPVSignal:has_content X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:MechanismOfDonepezil "Donepezil is a specific and reversible inhibitor of acetylcholinesterase, the dominating cholinesterase in the brain1"^^xsd:string)

