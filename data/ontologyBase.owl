ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:DosageContent X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:atomoxetin)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_atomoxetine_and_pediatric_patients_4rth_2015:DosageContent "Dosage ranged from 10 mg to 160 mg (median: 25 mg) in the 16 cases which reported this information."^^xsd:string)

