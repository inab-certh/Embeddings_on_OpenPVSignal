ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2013_m_agomelatine_and_QT_prolonged_4th:Drug-induced_long_qt_by_antidepressants)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_agomelatine_and_QT_prolonged_4th:Drug-induced_long_qt_by_antidepressants X2013_m_agomelatine_and_QT_prolonged_4th:qtProlonged)
ObjectPropertyAssertion(mp:references X2013_m_agomelatine_and_QT_prolonged_4th:Drug-induced_long_qt_by_antidepressants X2013_m_agomelatine_and_QT_prolonged_4th:Ref.13)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_agomelatine_and_QT_prolonged_4th:Drug-induced_long_qt_by_antidepressants "Drug-induced LQTS can be caused by cardiovascular and non-cardiovascular drugs. The cardiovascular side effects of older antidepressants, such as tricyclic anti-depressants, are well established and are known to be linked to their capacity to inhibit cardiac and vascular ion channels. Other newer antidepressant agents, such as selective serotonin reuptake inhibitors, mirtazapine and venlafaxine, also share antagonistic proper- ties with regard to voltage- dependent ion channels in different tissues.13"^^xsd:string)

