ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2013_m_febuxostat_and_hepatic_failure_2nd_2013:US_PI_for_febuxostat_and_hepatic_failure X2013_m_febuxostat_and_hepatic_failure_2nd_2013:febuxostat)
ObjectPropertyAssertion(mp:references X2013_m_febuxostat_and_hepatic_failure_2nd_2013:US_PI_for_febuxostat_and_hepatic_failure X2013_m_febuxostat_and_hepatic_failure_2nd_2013:Ref.2)
ObjectPropertyAssertion(mp:references X2013_m_febuxostat_and_hepatic_failure_2nd_2013:US_PI_for_febuxostat_and_hepatic_failure X2013_m_febuxostat_and_hepatic_failure_2nd_2013:Ref.3)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_febuxostat_and_hepatic_failure_2nd_2013:US_PI_for_febuxostat_and_hepatic_failure "Hepatic failure was added to the Warnings and Precautions section of the US Product Information (PI) for febuxostat in November 2012, but has not yet been added to the UK Summary of Product Characteristics (SPC).2,3 The US PI states that liver function should be tested at baseline and on development of symptoms that may indicate liver injury, and that febuxostat should be ceased if ALT is ≥ three times ULN."^^xsd:string)

