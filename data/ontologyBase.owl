ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_temozolomide_oesophagitis_5th:RadiationAsCauseOfOesophagitis X2015_m_temozolomide_oesophagitis_5th:oesophagitis)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_temozolomide_oesophagitis_5th:RadiationAsCauseOfOesophagitis "Oesophagitis can be a serious reaction that may have many causes; among them, radiation therapy that is usually employed along with temozolomide for the treatment of brain tumours.  "^^xsd:string)

