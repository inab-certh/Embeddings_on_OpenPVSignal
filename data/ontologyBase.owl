ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:literature_for_carbimazole X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:rhabdomyolysis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:literature_for_carbimazole X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:carbimazole)
ObjectPropertyAssertion(mp:references X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:literature_for_carbimazole X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Ref.4)
ObjectPropertyAssertion(mp:references X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:literature_for_carbimazole X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:literature_for_carbimazole "There is a literature report of another antithyroid drug, carbimazole (which is converted to thiamazole in the body) as a possible cause of rhabdomyolysis, in which Seow et al reported three patients who developed rhabdomyolyis during treatment with carbimazole.4 In the product literature for carbimazole, it is noted that isolated cases of myopathy have been reported.5"^^xsd:string)

