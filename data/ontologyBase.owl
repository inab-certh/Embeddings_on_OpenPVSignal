ObjectPropertyAssertion(mp:references X2019_m_levofloxacin_1st:Mechanism_of_levofloxacin X2019_m_levofloxacin_1st:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_levofloxacin_1st:Mechanism_of_levofloxacin "Levofloxacin is a synthetic antibacterial agent of the fluoroquinolone class"^^xsd:string)

