# Individual: X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report (more recent report)

AnnotationAssertion(rdfs:label X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report "more recent report"^^xsd:string)
ClassAssertion(obo:OAE_0001125 X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report X2016_m_denosumab_and_lichen_planus_6th_2016:lichen_planus)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report X2016_m_denosumab_and_lichen_planus_6th_2016:toxicEpidermalNecrolysis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report X2016_m_denosumab_and_lichen_planus_6th_2016:infliximab)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report X2016_m_denosumab_and_lichen_planus_6th_2016:Ref.8)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_denosumab_and_lichen_planus_6th_2016:more_recent_report "In a more recent report, a case of toxic epidermal necrolysis treated with infliximab, which subsequently triggered erosive LP involving the mouth and vulva was described. The authors noted that LP and lichenoid eruptions are an emerging side effect of TNF-α antagonists, with 14 cases reported to date. Seven cases were associated with infliximab, with the others attributed to etanercept, adalimumab and lenercept.8"^^xsd:string)

