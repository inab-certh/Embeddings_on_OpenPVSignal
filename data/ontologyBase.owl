ObjectPropertyAssertion(mp:references X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:glibenclamide_and_higher_risk_of_hypoglycaemia X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Ref.8)
ObjectPropertyAssertion(mp:references X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:glibenclamide_and_higher_risk_of_hypoglycaemia X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Ref.9)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:glibenclamide_and_higher_risk_of_hypoglycaemia "Several studies which evaluated the safety of SUs consistently showed that glibenclamide is associated with a higher risk of hypoglycaemia when compared to other SUs, including glipizide, gliclazide and glimepiride.6-9 Glibenclamide was associated with a 52% greater risk of experiencing at least one episode of hypoglycaemia compared with other secretagogues (relative risk 1.52 [95% CI 1.21-1.92]) and with an 83% greater risk compared with other sulfonylureas (1.83 [1.35- 2.49]).10"^^xsd:string)

