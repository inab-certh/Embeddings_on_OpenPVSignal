ClassAssertion(OpenPVSignal:Structured_Product_Labels_information X2019_m_Gi_pain_2019_4rth:US_product_info)
ClassAssertion(OpenPVSignal:Warning_Information X2019_m_Gi_pain_2019_4rth:US_product_info)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:liverDamage)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:stomachPain)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:upsetStomach)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:guaifenesin)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:paracetamol)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:phenylephrine)
ObjectPropertyAssertion(mp:references X2019_m_Gi_pain_2019_4rth:US_product_info X2019_m_Gi_pain_2019_4rth:Ref.6)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:US_product_info "Combination products with these substances in the US list upset stomach or stomach pain as signs of liver problems.6"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:Underlying_disease (Underlying disease)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:Underlying_disease "Underlying disease"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2019_m_Gi_pain_2019_4rth:Underlying_disease)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:Underlying_disease "An obvious confounding factor is the underlying disease in these cases, where abdominal pain, nausea and vomiting could occur. However, for many cases, the upper abdominal pain had a sudden onset after drug intake, and there was recovery reported after stopping the drug, suggesting a causal relationship to the combination product."^^xsd:string)

