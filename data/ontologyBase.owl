AnnotationAssertion(rdfs:label X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia "omeprazole triggering gynaecomastia"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia)
ObjectPropertyAssertion(OpenPVSignal:has_mechanism X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazole)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Gynecomastia)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.7)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.8)
ObjectPropertyAssertion(mp:references X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:Ref.9)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:omeprazoleTriggeringGynaecomastia "Omeprazole and its S-enantiomer esomeprazole at high concentrations appear to inhibit cytochrome P450 (CYP) 3A4 – which strongly catalyses the oxidation of estradiol, its major catabolic pathway – giving rise to an increase in estradiol levels.7 Omeprazole is extensively metabolised by CYP2C19, for which >15 variant alleles associated with a decreased metabolism have been identified (the frequency of poor metabolisers among Europeans ranges from 1% to 6% 8,9) and it is possible that such patients, when treated for long periods with higher doses of omeprazole, would be at particular risk for the development of gynaecomastia."^^xsd:string)

