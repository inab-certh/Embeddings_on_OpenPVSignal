ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_dabigatran_3rd_2016:ReportsAboutValvularAtrialFibrillationAndLansoprazole X2016_m_dabigatran_3rd_2016:dabigatran)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_dabigatran_3rd_2016:ReportsAboutValvularAtrialFibrillationAndLansoprazole X2016_m_dabigatran_3rd_2016:lansoprazole)
ObjectPropertyAssertion(mp:references X2016_m_dabigatran_3rd_2016:ReportsAboutValvularAtrialFibrillationAndLansoprazole X2016_m_dabigatran_3rd_2016:Ref.15)
ObjectPropertyAssertion(mp:references X2016_m_dabigatran_3rd_2016:ReportsAboutValvularAtrialFibrillationAndLansoprazole X2016_m_dabigatran_3rd_2016:Ref.16)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_dabigatran_3rd_2016:ReportsAboutValvularAtrialFibrillationAndLansoprazole "There are two more cases in the literature describing atrial thrombosis15,16: in these cases we consider the risk may have been increased by the presence of valvular atrial fibrillation in one and the concomitant use of lansoprazole in the other."^^xsd:string)

