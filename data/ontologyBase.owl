# Individual: <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology> (Trismus/lockjaw pathophysiology)

AnnotationAssertion(rdfs:label <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology> "Trismus/lockjaw pathophysiology"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology>)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology> X2019_m_Methylphenidate_2019_4rth:trismus)
ObjectPropertyAssertion(mp:references <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology> X2019_m_Methylphenidate_2019_4rth:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content <http://purl.org/OpenPVSignal/Signals/2019_4_methylphenidate_lockjaw.owl#Trismus/lockjaw_pathology> "Trismus, or lockjaw, is the inability to open the mouth, usually because of muscle spasms. Causes include physical trauma, oral/dental surgery, infections, and temporomandibular joint disease (e.g. rheumatoid arthritis). Trismus can also be part of a drug-induced dystonic reaction. Antipsychotics (e.g. risperidone, aripiprazole) and antiemetics (e.g. metoclopramide) are known to cause dystonia, and it seems to be caused by an abnormal dopaminergic activity involving the basal ganglia.4"^^xsd:string)

