ObjectPropertyAssertion(mp:references X2016_m_etanecert_6th:validityOfTheSignal X2016_m_etanecert_6th:Ref.3)
ObjectPropertyAssertion(mp:references X2016_m_etanecert_6th:validityOfTheSignal X2016_m_etanecert_6th:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_etanecert_6th:validityOfTheSignal "In the light of the ability of this medication to cause vasculitis1, together with the predisposition of the underlying disease4, detailed information provided by the original reports for this combination are consistent with manifestations of cutaneous vasculitis. These findings would therefore strengthen the hypothesis that etanercept induced injection site reactions are immune-mediated.2"^^xsd:string)

# Individual: X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept (well documented and characterised ADR for etanercept)

AnnotationAssertion(rdfs:label X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept "well documented and characterised ADR for etanercept"^^xsd:string)
ClassAssertion(OpenPVSignal:Warning_Information X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:bleeding)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:bruising)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:erythema)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:itching)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:pain)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:swelling)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:etanercept)
ObjectPropertyAssertion(mp:references X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept X2016_m_etanecert_6th:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_etanecert_6th:well_documented_and_characterised_ADR_for_etanercept "Etanercept is a recombinant receptor inhibitor for the Tumour Necrosis Factor and it is indicated as an immunomodulator for the treatment of both primary and secondary arthritis in adults.1 Etanercept injection site reactions are well documented and characterised; they are usually mild, including bleeding, bruising, erythema, itching, pain or swelling, and injection site ulcerations are not mentioned; these reactions usually occur within one month but recall injection site reactions can also occur at the most recent site of injection. In addition, serious skin reactions such as cutaneous vasculitis are also mentioned in the product information.In general, injection site ulcerations can be due to either an improper
injection technique that may result in infection and consequently to ulceration or to the drug itself via different mechanisms"^^xsd:string)

# Individual: X2017_m_chymotrypsin_1st:Anaphylactic_shock_pathophysiology (Anaphylactic shock pathophysiology)

AnnotationAssertion(rdfs:label X2017_m_chymotrypsin_1st:Anaphylactic_shock_pathophysiology "Anaphylactic shock pathophysiology"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2017_m_chymotrypsin_1st:Anaphylactic_shock_pathophysiology)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_chymotrypsin_1st:Anaphylactic_shock_pathophysiology X2017_m_chymotrypsin_1st:anaphylacticShock)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_chymotrypsin_1st:Anaphylactic_shock_pathophysiology "Anaphylactic shock is a severe and potentially fatal form of anaphylaxis, an allergic reaction. It can occur within seconds or minutes, up to hours, of exposure to the allergen. Signs and symptoms of anaphylaxis typically include more than one of the following: angioedema, urticaria, dyspnoea, wheezing, and hypoxemia, nausea, vomiting, abdominal pain, diarrhoea, light-headedness, dizziness, syncope, tachycardia, and in the most severe cases where the blood pressure is considerably affected, shock."^^xsd:string)

