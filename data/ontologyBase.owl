ObjectPropertyAssertion(OpenPVSignal:refers_to_signal X2016_m_denosumab_and_lichen_planus_6th_2016:Denosumab_and_lichen_planus X2016_m_denosumab_and_lichen_planus_6th_2016:pvSignal)
