ClassAssertion(obo:OAE_0001197 X2019_m_Methylphenidate_2019_4rth:Uzun_et_al_report)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Methylphenidate_2019_4rth:Uzun_et_al_report X2019_m_Methylphenidate_2019_4rth:dystonia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Methylphenidate_2019_4rth:Uzun_et_al_report X2019_m_Methylphenidate_2019_4rth:methylphenidate)
ObjectPropertyAssertion(mp:references X2019_m_Methylphenidate_2019_4rth:Uzun_et_al_report X2019_m_Methylphenidate_2019_4rth:Ref.17)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Methylphenidate_2019_4rth:Uzun_et_al_report "In another case, a 7-year-old female diagnosed with ADHD was prescribed 5 mg of immediate-release methylphenidate twice daily.17 After her third dose, she developed dystonic movements characterized by turning the neck sideways and twisted facial muscles."^^xsd:string)

