ClassAssertion(obo:OAE_0001197 X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypothyroidism)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:myopathy)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:rhabdomyolysis)
ObjectPropertyAssertion(mp:references X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Ref.11)
ObjectPropertyAssertion(mp:references X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Ref.12)
ObjectPropertyAssertion(mp:references X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Ref.13)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:hypotheroismPerSeIsNotAPossibleCauseOfRhabdomyolysis "It is also known that hypothyroidism can cause myopathy and rhabdomyolysis.11,12,13 This gives rise to the possibility that thiamazole induced hypothyroidism may have been a cause. Only two of the reports, however, mention hypothyroidism as a reaction so this appears to be an unlikely cause. "^^xsd:string)

