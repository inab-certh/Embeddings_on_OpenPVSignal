ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:LiteratureAndLabelling X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.12)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:LiteratureAndLabelling X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.14)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:LiteratureAndLabelling X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.3)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_2014_and_granulocytopenia_1st:LiteratureAndLabelling "Haematopoietic side-effects have not been reported with vemurafenib in either the US FDA product label or the UK SPC.3,11 Neutropenia was not reported in phase 1 or 2 clinical trials of vemurafenib, but two cases of neutropenia were observed among 336 patients in the vemurafenib arm of the phase 3 clinical trial of vemurafenib vs. dacarbazine.12,14
"^^xsd:string)

# Individual: X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib (Mechanism of Vemurafenib)

AnnotationAssertion(rdfs:label X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib "Mechanism of Vemurafenib"^^xsd:string)
ClassAssertion(OpenPVSignal:Mechanism X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.1)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_2014_and_granulocytopenia_1st:MechanismOfVemurafenib "Vemurafenib is a first-in-class serine-threonine protein kinase inhibitor, which inhibits the kinase activity of mutated B-Raf protein. The Ras-Raf- MEK-ERK mitogen activated protein kinase (MAPK) cascade is an important cytoplasmic signalling pathway involved in the regulation of normal somatic cell proliferation. Mutations in the genes encoding components of this pathway have been associated with a number of human cancers.1 An activating mutation in the BRAF gene, which encodes the serine-threonine protein kinase B-Raf, has been found to be present in 40-60 percent of melanomas, most commonly the BRAF V600E mutation.2"^^xsd:string)

# Individual: X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI (Neutropenia and sorafenib)

AnnotationAssertion(rdfs:label X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI "Neutropenia and sorafenib"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI X2014_m_vemurafenib_2014_and_granulocytopenia_1st:neutropenia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI X2014_m_vemurafenib_2014_and_granulocytopenia_1st:sorafenib)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.17)
ObjectPropertyAssertion(mp:references X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI X2014_m_vemurafenib_2014_and_granulocytopenia_1st:Ref.18)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_vemurafenib_2014_and_granulocytopenia_1st:NeutropeniaAndPKI "The product label for sorafenib, a multi-kinase inhibitor with potent activity against B-Raf, lists neutropenia as a common adverse effect but the drug also inhibits other kinases that are known to be involved in haematopoiesis.17,18"^^xsd:string)

