ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2017_m_noscapine_ADS_5th:Statement_1 X2017_m_noscapine_ADS_5th:noscapine)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_noscapine_ADS_5th:Statement_1 "“terrible pain, I was quite sure I had a heart attack or an aneurysm”"^^xsd:string)

