# Individual: X2019_m_Gi_pain_2019_4rth:statement_1 (statement 1)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_1 "statement 1"^^xsd:string)
ClassAssertion(mp:Statement X2019_m_Gi_pain_2019_4rth:statement_1)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:statement_1 "”Sharp/cramping pains in stomach. Right in between the ribs. Centre of stomach …. Nearly phoned ambulance. Pain was unbearable at one point.”"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:statement_2 (statement 2)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_2 "statement 2"^^xsd:string)
ClassAssertion(mp:Statement X2019_m_Gi_pain_2019_4rth:statement_2)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:statement_2 "“Sudden severe stomach cramps, dizziness, raised temperature and sudden severe vomiting”"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:statement_3 (statement 3)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_3 "statement 3"^^xsd:string)
ClassAssertion(mp:Statement X2019_m_Gi_pain_2019_4rth:statement_3)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:statement_3 "“…experienced severe stomach pain with 10 minutes [sic] of taking the tablets I then felt sick and vomited twice. I then felt ok apart from my cold symptoms.”"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:statement_4 (statement 4)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_4 "statement 4"^^xsd:string)
ClassAssertion(mp:Statement X2019_m_Gi_pain_2019_4rth:statement_4)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:statement_4 "“…experienced extreme stomach pain and vomiting just minutes after the medicine was taken, lasted about 30 minutes before returning to normal.”"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:statement_5 (statement 5)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_5 "statement 5"^^xsd:string)
ClassAssertion(mp:Statement X2019_m_Gi_pain_2019_4rth:statement_5)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Gi_pain_2019_4rth:statement_5 "“Within seconds of taking experienced severe pain in the stomach causing collapse and projectile vomiting. …the pain was so extreme ... collapse to the floor in pain.”"^^xsd:string)

# Individual: X2019_m_Gi_pain_2019_4rth:statement_6 (statement 6)

AnnotationAssertion(rdfs:label X2019_m_Gi_pain_2019_4rth:statement_6 "statement 6"^^xsd:string)
