ObjectPropertyAssertion(mp:references <http://purl.org/OpenPVSignal/Signals/2018_4_incosistent_labeling.owl#InfoRegardingHypoglycaemiaTriggeredByMetforminAndciprofloxacin/levofloxacin> X2018_m_incosistent_labelling_4rth_2018:Ref.2)
