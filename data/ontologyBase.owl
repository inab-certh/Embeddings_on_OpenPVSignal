ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:DetailedMechanismOfDPP4InhibitionAndCardiacFailure X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.10)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:DetailedMechanismOfDPP4InhibitionAndCardiacFailure X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.26)
