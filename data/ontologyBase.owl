ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_febuxostat_and_cardiac_failure_5th:PossibleMechanismOfFebuxostatTriggeringCardiacFailure X2014_m_febuxostat_and_cardiac_failure_5th:cardiacFailure)
ObjectPropertyAssertion(mp:references X2014_m_febuxostat_and_cardiac_failure_5th:PossibleMechanismOfFebuxostatTriggeringCardiacFailure X2014_m_febuxostat_and_cardiac_failure_5th:Ref.12)
