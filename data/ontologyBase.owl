ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:hyperthyroidism)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:increasedSweating)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:insomnia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:nervousness)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:palpitations)
ObjectPropertyAssertion(mp:references X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism X2017_m_levothyroxin_2nd:ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_levothyroxin_2nd:Sympotms_of_hyperthyroidism "Levothyroxine doses need to be carefully titrated, and the symptoms of overdose reflect those of hyperthyroidism. Many of these are similar to the symptoms and signs of adrenergic excess and include nervousness, palpitations, hyperactivity, increased sweating, insomnia, and more.2"^^xsd:string)

