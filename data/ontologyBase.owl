ObjectPropertyAssertion(mp:references X2015_m_desloratadine_and_qt_prolongation_2nd:labelling_of_desloratadine X2015_m_desloratadine_and_qt_prolongation_2nd:Ref.1)
ObjectPropertyAssertion(mp:references X2015_m_desloratadine_and_qt_prolongation_2nd:labelling_of_desloratadine X2015_m_desloratadine_and_qt_prolongation_2nd:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_desloratadine_and_qt_prolongation_2nd:labelling_of_desloratadine "QT prolongation is not labelled for desloratadine in the UK summary of product characteristics nor the FDA product label.1,2"^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_desloratadine_and_qt_prolongation_2nd:labelling_of_desloratadine "The enzyme responsible for the metabolism of desloratadine has not yet been identified and the product label states that the possibility that desloratadine could interact with other drugs cannot be excluded.1"^^xsd:string)

