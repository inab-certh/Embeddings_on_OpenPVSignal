# Individual: X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial (ANDROMEDA clinical trial)

AnnotationAssertion(rdfs:label X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial "ANDROMEDA clinical trial"^^xsd:string)
ClassAssertion(OpenPVSignal:Clinical_trial_information X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial)
ObjectPropertyAssertion(OpenPVSignal:is_supported_by_statistical_entity X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial X2014_m_dronedarone_ventricular_arrhythmia_6th:HRFromANDROMEDATrial)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial X2014_m_dronedarone_ventricular_arrhythmia_6th:dronedarone)
ObjectPropertyAssertion(mp:references X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial X2014_m_dronedarone_ventricular_arrhythmia_6th:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_dronedarone_ventricular_arrhythmia_6th:ADROMEDAClinicalTrial "The ANDROMEDA trial was early stopped early due to a high mortality rate (25 patients in the dronedarone group vs. 12 in the placebo group [HR 2.13: 95%CI 1.07-4.25; p=0.03). In this trial, most deaths were due to worsening of heart failure, however deaths due to dysrhythmia or sudden death were also observed in the dronedarone group. It was difficult to draw definitive conclusions regarding cardiac safety of dronedarone because of the presence of potential confounding factors such as severe heart failure and left ventricular systolic dysfunction."^^xsd:string)

