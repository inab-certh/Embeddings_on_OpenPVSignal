ObjectPropertyAssertion(OpenPVSignal:refers_to_primary_suspect_drug X2018_m_Aflibercept_6th_2018:Clinical_trial_report_for_Aflibercept X2018_m_Aflibercept_6th_2018:Aflibercept)
