ObjectPropertyAssertion(OpenPVSignal:is_subgroup_of X2014_m_finasterine_and_convulsions_4th:ReportsFromUS X2014_m_finasterine_and_convulsions_4th:reportsForAnalysisWithoutDuplicatesForTheTermConvulsionsAndConvulsionsGrandMal)
