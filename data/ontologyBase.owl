# Individual: X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Pathophysiology_of_anaphylactic_shock (Pathophysiology of anaphylactic shock)

AnnotationAssertion(rdfs:label X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Pathophysiology_of_anaphylactic_shock "Pathophysiology of anaphylactic shock"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Pathophysiology_of_anaphylactic_shock)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Pathophysiology_of_anaphylactic_shock X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:AnaphylacticShock)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Omalizumab_and_anaphylactic_shock_in_females_1st:Pathophysiology_of_anaphylactic_shock "\"Anaphylactic shock is a severe clinical
manifestation that occurs suddenly and may cause death. It typically causes more than one of the
following: an itchy rash, throat or tongue swelling,
shortness of breath, vomiting, lightheadedness,
low blood pressure and loss of consciousness.
These symptoms occur typically over minutes to
hours. Many drugs can induce anaphylactic shock,
either with an immunological or an “idiosyncratic”
(not immunological) mechanism.\""^^xsd:string)

