ClassAssertion(obo:OAE_0001182 X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Palpitations)
ObjectPropertyAssertion(OpenPVSignal:refers_to_concomitant_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Enalapril)
ObjectPropertyAssertion(OpenPVSignal:refers_to_concomitant_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Furosemide)
ObjectPropertyAssertion(OpenPVSignal:refers_to_concomitant_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:IsosorbideDinitrate)
ObjectPropertyAssertion(OpenPVSignal:refers_to_concomitant_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Morphine)
ObjectPropertyAssertion(OpenPVSignal:refers_to_concomitant_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Nifedipine)
ObjectPropertyAssertion(OpenPVSignal:refers_to_primary_suspect_drug X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:glibenclamide)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies "\"An ICSR from an Asian country reports hypoglycaemia in a 52-year-old woman who was started on dual therapy with metformin 1 g daily and glibenclamide 5 mg; the TTO was 10 days. On day 8, a prescription of 2 g of amoxicillin is reported (only one-day of treatment), and doxycycline 200 mg daily, given for three days, because of an acute upper respiratory infection.
Some anti-infective agents may enhance the hypoglycaemic effect of glibenclamide and infection itself can trigger hypoglycaemia.
An ICSR from a non-Asian country reports hypoglycaemia and palpitations in a 59-year-old woman treated with glibenclamide 5 mg over nine months. Two days before the hypoglycaemic event occurred, the patient had received medication for a cardiac event (morphine, nifedipine, isosorbide dinitrate, furosemide, enalapril).\""^^xsd:string)

# Individual: X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 (Incident comorbidities and incident concomitant therapies 2)

AnnotationAssertion(rdfs:label X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 "Incident comorbidities and incident concomitant therapies 2"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:AtrialFibrillation)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:LeftVentricularEjectionFraction)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Palpitations)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Glibenclamideglyburide_and_palpitations_in_the_Asian_population_2nd_2019:Incident_comorbidities_and_incident_concomitant_therapies_2 "In two reports from a non-Asian country (TTO 170 days and 215 days), palpitations are more likely related with other morbidities (atrial fibrillation, reduced left ventricular ejection fraction). In another ICSR from an Asian country (TTO 270 days), other medications suggesting an acute coronary syndrome are reported."^^xsd:string)

