# Individual: <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis> (Alzheimer's disease pathogenesis)

AnnotationAssertion(rdfs:label <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis> "Alzheimer's disease pathogenesis"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis>)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis> X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:Alzheimer)
ObjectPropertyAssertion(mp:references <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis> X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:Ref.2)
DataPropertyAssertion(OpenPVSignal:has_content <http://purl.org/OpenPVSignal/Signals/2012_2_donepezil_interaction_seretonin_syndrome#Alzheimer's_disease_pathogenesis> "The pathogenesis of Alzheimer’s disease has been linked to the deficiency of the neurotransmitter acetylcholine and the acetylcholinesterase inhibitors were subsequently introduced as treatment for Alzheimer’s. Its efficacy is believed to be attained through the augmentation of acetylcholine-mediated synaptic transmission. It is also shown that this type of drug protects cells from the toxicity of free radicals and β–amyloid-induced injury.2"^^xsd:string)

