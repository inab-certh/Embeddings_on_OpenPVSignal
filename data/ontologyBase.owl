ClassAssertion(OpenPVSignal:Adverse_Effect X2018_m_brivudine_5fu_6th_2018:Mucositis)

# Individual: X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1 (Onset for patient 1)

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1 "Onset for patient 1"^^xsd:string)
ClassAssertion(time:DurationDescription X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1 "An elderly patient was given a 6-day treatment of brivudine for shingles. Three days later, brivudine treatment was ended, and the patient was administered a 5-FU bolus to manage his colon cancer. Five days later the patient was hospitalised for severe mucositis and developed severe bone marrow aplasia. He died soon after on an unspecified date."^^xsd:string)
DataPropertyAssertion(time:nominalPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1 "days"^^xsd:string)
DataPropertyAssertion(time:numericPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient1 "5"^^xsd:integer)

# Individual: X2018_m_brivudine_5fu_6th_2018:OnsetForPatient2 (Onset for patient 2)

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:OnsetForPatient2 "Onset for patient 2"^^xsd:string)
ClassAssertion(time:DurationDescription X2018_m_brivudine_5fu_6th_2018:OnsetForPatient2)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_brivudine_5fu_6th_2018:OnsetForPatient2 "After returning to her home country she presented to the hospital feeling generally unwell. She was hospitalized and eventually developed massive mucositis with ulcers in the mouth and throat region. The report does not state the outcome. "^^xsd:string)

# Individual: X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3 (Onset for patient 3 )

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3 "Onset for patient 3 "^^xsd:string)
ClassAssertion(time:DurationDescription X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3 "After the second cycle the patient developed shingles and the treating dermatologist prescribed brivudine (Nervinex). Three days after completing the 7-day course of brivudine, the final cycle of 5- FU was administered; two days later the patient presented feeling very tired and generally unwell. The patient was hospitalised, blood tests showed severe pancytopenia, and 10 days later the patient died"^^xsd:string)
DataPropertyAssertion(time:nominalPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3 "days"^^xsd:string)
DataPropertyAssertion(time:numericPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient3 "2"^^xsd:integer)

# Individual: X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4 (Onset for patient 4)

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4 "Onset for patient 4"^^xsd:string)
ClassAssertion(time:DurationDescription X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4 "On 1 April, the patient started treatment with brivudine. On 2 April, she stopped the treatment with brivudine, after an intake of two tablets. On 5 April, capecitabine was withdrawn, the patient was hospitalised and eventually died due to bone marrow depression. "^^xsd:string)
DataPropertyAssertion(time:nominalPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4 "days"^^xsd:string)
DataPropertyAssertion(time:numericPosition X2018_m_brivudine_5fu_6th_2018:OnsetForPatient4 "3"^^xsd:integer)

