# Individual: X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 (possible mechanism of baclofen precipitating renal failure1)

AnnotationAssertion(rdfs:label X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 "possible mechanism of baclofen precipitating renal failure1"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 X2013_m_baclofen_and_renal_failure_6th:chronicHeartFailure)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 X2013_m_baclofen_and_renal_failure_6th:renalFailure)
ObjectPropertyAssertion(mp:references X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 X2013_m_baclofen_and_renal_failure_6th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure1 "Baclofen is a GABA[B] receptor agonist. Microinjection in rats into the paraventricular nucleus has been found to induce a dose-dependent fall of arterial pressure, accompanied by reduced heart rate and reduced renal sympathetic nerve activity in a rat model which is claimed to simulate chronic heart failure"^^xsd:string)

# Individual: X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure2 (possible mechanism of baclofen precipitating renal failure2)

AnnotationAssertion(rdfs:label X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure2 "possible mechanism of baclofen precipitating renal failure2"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure2)
ObjectPropertyAssertion(mp:references X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure2 X2013_m_baclofen_and_renal_failure_6th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_baclofen_and_renal_failure_6th:possibleMechanismOfBaclofenPrecipitatingRenalfailure2 "Intrathecal use could result in inadvertently high concentrations in central areas, activating mechanisms described in the study by Wang et.al.5 Inadvertent injection into the subdural space could have the same effect."^^xsd:string)

