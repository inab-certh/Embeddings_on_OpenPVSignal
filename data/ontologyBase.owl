ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Product_labelling_for_nintedanib X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:pancreatitis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Product_labelling_for_nintedanib X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:vomiting)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Product_labelling_for_nintedanib X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:nintedanib)
ObjectPropertyAssertion(mp:references X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Product_labelling_for_nintedanib X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Ref.3)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_Nintedanib_and_ischaemic_colitis_6th_2019:Product_labelling_for_nintedanib "Product labelling for nintedanib includes warnings for diarrhoea and gastrointestinal perforation in section 4.4 of the Summary of Product Characteristics. There is also information regarding management options for serious cases of diarrhoea including hydration, anti-diarrhoeal products, and dose reduction and information regarding potential risk factors for gastrointestinal perforation, such as previous abdominal surgery or peptic ulceration, and diverticular disease and concomitant use of corticosteroids or NSAIDs. Included in the list of ADRs in section 4.8 are nausea, vomiting, diarrhoea, abdominal pain and pancreatitis.3
 the label for nintedanib 
specifically cautions for acute myocardial ischaemia in the treatment in patients at higher cardiovascular risk including known coronary artery disease.3"^^xsd:string)

