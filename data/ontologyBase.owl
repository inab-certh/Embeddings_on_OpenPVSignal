# Individual: X2015_m_Desloratadine_and_aggressive_reaction_6th:case_2_info (case 2 info)

AnnotationAssertion(rdfs:label X2015_m_Desloratadine_and_aggressive_reaction_6th:case_2_info "case 2 info"^^xsd:string)
