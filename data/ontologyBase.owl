# Individual: X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems (Wanger et al. report)

AnnotationAssertion(rdfs:label X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems "Wanger et al. report"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems)
ClassAssertion(OpenPVSignal:Warning_Information X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:DepressedMood)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:Depression)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:Panic_disorder)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:agoraphobia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:obsessive-compulsive_disorder)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:levonorgestrel)
ObjectPropertyAssertion(mp:references X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:Ref.8)
ObjectPropertyAssertion(mp:references X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems X2018_m_desogestrel_2018_5th:Ref.9)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_desogestrel_2018_5th:Progestogens_and_psychiatric_problems "Wagner et al. described in 1994 two cases of major depression and panic disorder while on levonorgestrel. In 1996 the same author published another article about five women who all developed major depression and where two also developed obsessive-compulsive disorder and one of these women also developed agoraphobia, while using levonorgestrel. These women had no prior psychiatric history and all the ADRs resolved after removal of levonorgestrel.8,9"^^xsd:string)

