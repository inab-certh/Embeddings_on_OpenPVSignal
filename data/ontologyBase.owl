ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_vortioxetine_and_aggression_2019_5th:Product_labelling_for_paroxetine X2019_m_vortioxetine_and_aggression_2019_5th:paroxetine)
ObjectPropertyAssertion(mp:references X2019_m_vortioxetine_and_aggression_2019_5th:Product_labelling_for_paroxetine X2019_m_vortioxetine_and_aggression_2019_5th:Ref.19)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_vortioxetine_and_aggression_2019_5th:Product_labelling_for_paroxetine "In spite of the lack of consensus on causality, the Pharmacovigilance Risk Assessment Committee at the EMA concluded that the evidence was enough to include aggression in the product labelling for paroxetine in 2015.18"^^xsd:string)

