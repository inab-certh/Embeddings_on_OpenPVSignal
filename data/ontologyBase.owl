ObjectPropertyAssertion(mp:references X2015_m_vemurafenib_and_thrombocytopenia_3rd:LiteratureAndLabelling X2015_m_vemurafenib_and_thrombocytopenia_3rd:Ref.6)
ObjectPropertyAssertion(mp:references X2015_m_vemurafenib_and_thrombocytopenia_3rd:LiteratureAndLabelling X2015_m_vemurafenib_and_thrombocytopenia_3rd:Ref.7)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_vemurafenib_and_thrombocytopenia_3rd:LiteratureAndLabelling "Thrombocytopenia is not listed as a possible ADR for vemurafenib in any of the sources that were checked, including the EMA6, UK Summary of Product Characteristics7 and the US FDA Product Label.3 Neutropenia is the only haematological ADR listed in the product information."^^xsd:string)

