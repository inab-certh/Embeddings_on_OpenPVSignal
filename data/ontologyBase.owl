# Individual: X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics (Peripheral Neuropathy and chemotherapeutics)

AnnotationAssertion(rdfs:label X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics "Peripheral Neuropathy and chemotherapeutics"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:neuropathyPeripheral)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:TNFaBlockers)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:platinumAgents)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:taxanes)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:vincaAlkaloids)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:bortezomib)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:thalidomide)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:Ref.11)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics X2017_m_ruxolitinib_4th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_ruxolitinib_4th:PeripheralNeuropathyAndChemotherapeutics "Peripheral neuropathy is a common adverse effect of several chemotherapeutic agents such as taxanes, platinum agents, vinca alkaloids, thalidomide, and bortezomib, a proteasome inhibitor.  No single mechanism explaining the peripheral neuropathy has been identified and the precise pathophysiology remains complex.11 A number of mechanisms for drug-induced peripheral neuropathy have been postulated, including immune-based demyelination.5"^^xsd:string)

# Individual: X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information (Peripheral neuropathy information)

AnnotationAssertion(rdfs:label X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information "Peripheral neuropathy information"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information X2017_m_ruxolitinib_4th:neuropathyPeripheral)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information X2017_m_ruxolitinib_4th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_ruxolitinib_4th:Peripheral_neuropathy_information "Peripheral neuropathy may be caused by a number of drugs and is one of the main reasons for patients to prematurely terminate antineoplastic treatment. Drug- induced peripheral neuropathies are often characterized by the development of a subacute or chronic, symmetrical polyneuropathy with a predominant sensory involvement.5"^^xsd:string)

# Individual: X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy (Proposed mechanism of ruxolitinib causing peripheral neuropathy)

AnnotationAssertion(rdfs:label X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy "Proposed mechanism of ruxolitinib causing peripheral neuropathy"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy X2017_m_ruxolitinib_4th:neuropathyPeripheral)
ObjectPropertyAssertion(mp:references X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy X2017_m_ruxolitinib_4th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_ruxolitinib_4th:Proposed_mechanism_of_ruxolitinib_causing_peripheral_neuropathy "Molecular mechanisms of drug-induced peripheral neuropathies have been addressed in several studies and a number of mechanisms have been postulated, including cytotoxic inflammatory changes, mitochondrial toxicity and enhanced oxidative stress, microtubular function disruption, voltage-gated ion channel dysfunction, functional impairment of ion channels of the transient receptor potential family, induction of neuronal apoptosis in dorsal root ganglia, demyelination, and reduction of VEGF neuro-protective action"^^xsd:string)

