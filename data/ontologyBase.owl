# Individual: X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI (more likely alternative reasons for AKI)

AnnotationAssertion(rdfs:label X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI "more likely alternative reasons for AKI"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:acuteKidneyInjury)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:pancytopenia)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:sepsis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI <http://purl.org/OpenPVSignal/Signals/2018_1_iprofloxacin_enalapril_acute_kidney_injury.owl#lyell'sSyndrome>)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:antibiotics)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:dronedarone)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:furosemide)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI X2018_m_ciprofloxacin_1st_2018:metamizole)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_ciprofloxacin_1st_2018:more_likely_alternative_reasons_for_AKI "Assessment of individual case reports indicated a more likely alternative reason for AKI than a nephrotoxic effect of ciprofloxacin with enalapril in five patients (cases 12-16). These were dronedarone-related AKI (12), Lyell’s syndrome attributed to allopurinol or, less likely, ciprofloxacin (13), sepsis, pancytopenia and AKI with multiple antibiotics (14), AKI after multiple antibiotics for chemotherapy-related infection (15), a combined effect of metamizole, an NSAID, added to furosemide and enalapril two days prior to AKI onset with ciprofloxacin commenced on the day of AKI onset (16)."^^xsd:string)

