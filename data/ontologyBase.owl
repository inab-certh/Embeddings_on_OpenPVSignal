ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2018_m_desogestrel_2018_5th:post_marketing_experience X2018_m_desogestrel_2018_5th:Hormonal_Contraceptives_for_Systemic_use)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:post_marketing_experience X2018_m_desogestrel_2018_5th:levonorgestrel)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_desogestrel_2018_5th:post_marketing_experience X2018_m_desogestrel_2018_5th:norethindrone-ethinyl_estradiol-iron)
ObjectPropertyAssertion(mp:references X2018_m_desogestrel_2018_5th:post_marketing_experience X2018_m_desogestrel_2018_5th:Ref.7)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_desogestrel_2018_5th:post_marketing_experience "The fact that panic attacks and suicidal ideation are mentioned under post marketing experience for the hormonal contraceptive drug containing ethinylestradiol/iron/ norethisterone and the case reports of another progestin levonorgestrel – causing panic attacks as well as other unlabelled psychiatric problems further strengthen a possible causal relationship between desogestrel and the highlighted adverse reactions."^^xsd:string)

