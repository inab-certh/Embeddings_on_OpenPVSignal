ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_denosumab_vasculitis_6th:DenosumabAndMusculoskeletalPain X2016_m_denosumab_vasculitis_6th:denosumab)
ObjectPropertyAssertion(mp:references X2016_m_denosumab_vasculitis_6th:DenosumabAndMusculoskeletalPain X2016_m_denosumab_vasculitis_6th:Ref.1)
DataPropertyAssertion(mp:citation X2016_m_denosumab_vasculitis_6th:DenosumabAndMusculoskeletalPain "The most common side effects with denosumab (seen in more than one patient in ten) are musculoskeletal pain and pain in the extremity . "^^xsd:string)

