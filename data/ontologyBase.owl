AnnotationAssertion(rdfs:label X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:potential_mechanism_of_interaction "potential mechanism of interaction"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:potential_mechanism_of_interaction)
ObjectPropertyAssertion(mp:references X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:potential_mechanism_of_interaction X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:potential_mechanism_of_interaction "In vitro studies have shown that the cytochrome  P450 isoenzymes CYP3A4 and to some extent  CYP2D6 are involved in the metabolism of  donepezil. Interaction studies in vitro have also  shown that drugs like ketokonazol and kinidin  (inhibitors of CYP3A4 and CYP2D6 respectively)  inhibits the metabolism of donepezil. 1 This means  that these drugs and other inhibitors of these  enzymes could inhibit the metabolism of donepezil  and thus lead to higher concentrations of the drug."^^xsd:string)

