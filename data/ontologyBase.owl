# Class: <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)> (Information Component (IC))

AnnotationAssertion(rdfs:comment <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)> "IC stands for “information component”, which is an indicator value for disproportionate reporting when using the method for disproportionality analysis developed by UMC."^^xsd:string)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)> "https://www.who-umc.org/vigibase/vigilyze/analytics-in-vigilyze/"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)> "Information Component (IC)"^^xsd:string)
SubClassOf(<http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)> OpenPVSignal:Disproportionality_Analysis_Measure)

# Class: <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC0005)> (Information Component 0005 (IC0005))

AnnotationAssertion(rdfs:comment <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC0005)> "The lower endpoint of a 99.9% credibility interval for the Information Component, IC0005 is used to support analysis of subgroup-specific associations between substances and effects analogously to how IC025 is used for general analysis of substance-effect associations: a positive value for IC0005 suggests, but does not prove, a causal relation between the substance and the reaction in the subgroup under consideration."^^xsd:string)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC0005)> "https://www.who-umc.org/vigibase/vigilyze/analytics-in-vigilyze/"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC0005)> "Information Component 0005 (IC0005)"^^xsd:string)
SubClassOf(<http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC0005)> <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_(IC)>)

# Class: <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_005_(IC005)> (Information Component 005 (IC005))

AnnotationAssertion(rdfs:comment <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_005_(IC005)> "The lower endpoint of a 99% credibility interval for the Information Component, IC005 is used to support analysis of subgroup-specific associations between substances and effects analogously to how IC025 is used for general analysis of substance-effect associations: a positive value for IC005 suggests, but does not prove, a causal relation between the substance and the reaction in the subgroup under consideration."^^xsd:string)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.org/OpenPVSignal/OpenPVSignal.owl#Information_Component_005_(IC005)> "https://www.who-umc.org/vigibase/vigilyze/analytics-in-vigilyze/"^^xsd:string)
