ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:SmPC_of_metronidazole X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:toxicEpidermalNecrolysis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:SmPC_of_metronidazole X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:metronidazole)
ObjectPropertyAssertion(mp:references X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:SmPC_of_metronidazole X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:Ref.3)
DataPropertyAssertion(OpenPVSignal:has_content X2016_m_Benznidazole_and_severe_skin_reactions_2nd_2016:SmPC_of_metronidazole "A possible causal association for severe skin reactions and benznidazole is further supported by the fact that SJS and TEN have been associated with imidazole derivatives, and are listed in the Summary of Product Characteristics of metronidazole.3"^^xsd:string)

