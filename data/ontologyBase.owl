# Individual: X2018_m_brivudine_5fu_6th_2018:Herpes_zoster (Herpes zoster)

AnnotationAssertion(rdfs:label X2018_m_brivudine_5fu_6th_2018:Herpes_zoster "Herpes zoster"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2018_m_brivudine_5fu_6th_2018:Herpes_zoster)
