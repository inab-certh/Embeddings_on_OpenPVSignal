ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2017_m_Lamivudine_2017_1st:Product_labels_for_lamivudine X2017_m_Lamivudine_2017_1st:lamivudine)
ObjectPropertyAssertion(mp:references X2017_m_Lamivudine_2017_1st:Product_labels_for_lamivudine X2017_m_Lamivudine_2017_1st:Ref.14)
ObjectPropertyAssertion(mp:references X2017_m_Lamivudine_2017_1st:Product_labels_for_lamivudine X2017_m_Lamivudine_2017_1st:Ref.15)
ObjectPropertyAssertion(mp:references X2017_m_Lamivudine_2017_1st:Product_labels_for_lamivudine X2017_m_Lamivudine_2017_1st:Ref.16)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_Lamivudine_2017_1st:Product_labels_for_lamivudine "The product labels for lamivudine, approved by various regulatory agencies, including EMA, FDA and Health Canada, do not list decreased hearing as an adverse drug reaction.14-16"^^xsd:string)

