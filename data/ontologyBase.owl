ObjectPropertyAssertion(mp:references X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:ReportsGroupContent X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:Ref.10)
ObjectPropertyAssertion(mp:references X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:ReportsGroupContent X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:Ref.3)
ObjectPropertyAssertion(mp:references X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:ReportsGroupContent X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:Ref.4)
ObjectPropertyAssertion(mp:references X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:ReportsGroupContent X2016_m_levetiracetam_and_impaired_renal_function_2nd_2016:Ref.5)
