# Individual: X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology (optic neuritis pathophysiology)

AnnotationAssertion(rdfs:label X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology "optic neuritis pathophysiology"^^xsd:string)
ClassAssertion(OpenPVSignal:Free_text_reporting_element X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology X2014_m_pamindronic_acid_and_optic_neuritis_5th:opticNeuritis)
ObjectPropertyAssertion(mp:references X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology X2014_m_pamindronic_acid_and_optic_neuritis_5th:ref2)
ObjectPropertyAssertion(mp:references X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology X2014_m_pamindronic_acid_and_optic_neuritis_5th:ref3)
ObjectPropertyAssertion(mp:references X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology X2014_m_pamindronic_acid_and_optic_neuritis_5th:ref4)
DataPropertyAssertion(OpenPVSignal:has_content X2014_m_pamindronic_acid_and_optic_neuritis_5th:optic_neuritis_pathobiology "Optic neuritis is a common inflammatory disease of the optic nerve.2 It may cause sudden, reduced vision in the affected eye. The exact cause of optic neuritis is unknown. Conditions that have been linked with optic neuritis include autoimmune diseases, bacterial, fungal, viral and respiratory infections and multiple sclerosis.3 A number of drugs have been implicated in the development of optic neuritis including ethambutol in particular as well as linezolid, amiodarone and cGMP- specific phosphodiesterase type five inhibitors.4"^^xsd:string)

