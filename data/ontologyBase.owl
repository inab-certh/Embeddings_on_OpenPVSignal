ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2019_m_vortioxetine_and_aggression_2019_5th:US_Package_Insert X2019_m_vortioxetine_and_aggression_2019_5th:aggression)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_vortioxetine_and_aggression_2019_5th:US_Package_Insert X2019_m_vortioxetine_and_aggression_2019_5th:antidepressants)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2019_m_vortioxetine_and_aggression_2019_5th:US_Package_Insert X2019_m_vortioxetine_and_aggression_2019_5th:vortioxetine)
ObjectPropertyAssertion(mp:references X2019_m_vortioxetine_and_aggression_2019_5th:US_Package_Insert X2019_m_vortioxetine_and_aggression_2019_5th:Ref.11)
DataPropertyAssertion(OpenPVSignal:has_content X2019_m_vortioxetine_and_aggression_2019_5th:US_Package_Insert "The US Package Insert (intended for both health care providers and patients) refers to the association of aggression with other antidepressants, but it also mentions an aggression-like term (sudden outbursts of anger) in specific association with discontinuation of vortioxetine.11"^^xsd:string)

