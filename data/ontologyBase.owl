AnnotationAssertion(OpenPVSignal:has_ATC_code X2019_m_vortioxetine_and_aggression_2019_5th:SSRIs "N06AB"^^xsd:string)
AnnotationAssertion(rdfs:label X2019_m_vortioxetine_and_aggression_2019_5th:SSRIs "SSRIs"^^xsd:string)
