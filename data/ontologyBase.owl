ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:bloodyDiarrhoea)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:constipation)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:hemorrhoids)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:azithromycin)
ObjectPropertyAssertion(mp:references X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:Ref.8)
ObjectPropertyAssertion(mp:references X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin X2013_m_roflumilast_and_melaena_5th:Ref.9)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_roflumilast_and_melaena_5th:WarningForAzithromycin "Similarly, known ADRs of azithromycin are bloody diarrhoea and constipation.8
 Constipation may also lead to haemorrhoids (swollen veins in the rectum).9"^^xsd:string)

# Individual: X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors (Warning for PDE4 inhibitors)

AnnotationAssertion(rdfs:label X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors "Warning for PDE4 inhibitors"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors)
ClassAssertion(OpenPVSignal:Warning_Information X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors)
ObjectPropertyAssertion(OpenPVSignal:refers_to_class X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors X2013_m_roflumilast_and_melaena_5th:fgd)
ObjectPropertyAssertion(mp:references X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors X2013_m_roflumilast_and_melaena_5th:Ref.10)
ObjectPropertyAssertion(mp:references X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors X2013_m_roflumilast_and_melaena_5th:Ref.4)
ObjectPropertyAssertion(mp:references X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors X2013_m_roflumilast_and_melaena_5th:Ref.5)
DataPropertyAssertion(OpenPVSignal:has_content X2013_m_roflumilast_and_melaena_5th:WarningForPDE4Inhibitors "It has been shown previously that GI adverse effects of PDE inhibitors have been suspected with various mechanisms for decades.4,5,10 These mechanisms, increased gastric acid production (described as \"possibly related to the class of the compound\" by the CHMP) and/or arteritis, may lead to manifestations of the various GI reactions reported (duodenal ulcer, gastritis, diverticulosis etc.); with consequent, melaena particularly in sensitive patients (for example when treated with anticoagulants). The fact that the GI manifestations have been reported as adverse effects and not as concomitant sicknesses in all cases, seem to support this explanation."^^xsd:string)

