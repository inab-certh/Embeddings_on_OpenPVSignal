ObjectPropertyAssertion(mp:references X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:Alzheimer_as_confounder X2012_m_donepezil_SSRI_SNRI_interaction_Serotoni_syndrome_2nd:Ref.10)
