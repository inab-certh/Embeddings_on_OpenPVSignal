ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect <http://purl.org/OpenPVSignal/Signals/2014_4_dronedarone_polyneuropathy#DiTrapani/Freeman> X2014_m_dronedarone_and_polyneuropathy_4th:myoclonic_jerking)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect <http://purl.org/OpenPVSignal/Signals/2014_4_dronedarone_polyneuropathy#DiTrapani/Freeman> X2014_m_dronedarone_and_polyneuropathy_4th:neurotoxicity)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect <http://purl.org/OpenPVSignal/Signals/2014_4_dronedarone_polyneuropathy#DiTrapani/Freeman> X2014_m_dronedarone_and_polyneuropathy_4th:tremor)
