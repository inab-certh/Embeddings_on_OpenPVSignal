ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_vemurafenib_and_sepsis_2nd:PreDisposingFactors X2015_m_vemurafenib_and_sepsis_2nd:sepsis)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_vemurafenib_and_sepsis_2nd:PreDisposingFactors "Given the nature of the underlying indication for treatment, it is possible that the two further patients who developed sepsis in association with pneumonia and one patient who developed sepsis in association with cholecystitis may have developed these infections as a result of lung and liver metastases, respectively. "^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_vemurafenib_and_sepsis_2nd:PreDisposingFactors "predisposing factors in addition to metastatic melanoma are excluded (neutropenia, intestinal perforation, metastatic obstruction of bronchus, underlying urinary tract pathology)"^^xsd:string)

