ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:Known_AE_for_thiamazole X2016_m_thiamazole_and_rhabdomyolysis_4rth_2016:insulinAutoimmuneSyndrome)
