# Individual: X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:male_obesity_as_a_confounder (male obesity as a confounder)

AnnotationAssertion(rdfs:label X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:male_obesity_as_a_confounder "male obesity as a confounder"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2019_m_Esomeprazole_and_gynaecomastia_in_obese_adults_2nd_2019:male_obesity_as_a_confounder)
