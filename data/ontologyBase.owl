DataPropertyAssertion(OpenPVSignal:has_last_name X2017_m_sglt2_inhibitors_3rd:Dr_Rebecca_E_Chandler "Chandler"^^xsd:string)

# Individual: X2017_m_sglt2_inhibitors_3rd:Literature_and_Labelling (Literature and Labelling)

AnnotationAssertion(rdfs:label X2017_m_sglt2_inhibitors_3rd:Literature_and_Labelling "Literature and Labelling"^^xsd:string)
ClassAssertion(OpenPVSignal:Literature_information X2017_m_sglt2_inhibitors_3rd:Literature_and_Labelling)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_sglt2_inhibitors_3rd:Literature_and_Labelling "The summary of product characteristics for each of these products notes that most genital infections were mild to moderate and only rarely resulted in discontinuation. The patient information leaflet notes only that genital infections are common to very common and manifest with irritation, itching, unusual discharge or odour. There is no information provided to the patient to seek medical consultation for treatment of these infections."^^xsd:string)

# Individual: X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors (Mechanism of SGLT-2 inhibitors)

AnnotationAssertion(rdfs:label X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors "Mechanism of SGLT-2 inhibitors"^^xsd:string)
ClassAssertion(OpenPVSignal:Mechanism X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors)
ObjectPropertyAssertion(OpenPVSignal:is_part_of X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors X2017_m_sglt2_inhibitors_3rd:introduction)
ObjectPropertyAssertion(mp:references X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors X2017_m_sglt2_inhibitors_3rd:Ref.1)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_sglt2_inhibitors_3rd:Mechanism_of_SGLT-2_inhibitors "SLGT-2i work by inhibiting glucose reabsorption in the kidney and thereby promoting urinary excretion of glucose. Studies have revealed that SGLT-2i have beneficial effects on blood glucose levels, but also they reduce blood pressure and induce weight loss. Given that the action of these agents is independent of both insulin secretion and insulin action, another benefit of these agents is a lower risk of hypoglycaemia."^^xsd:string)

# Individual: X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections (Mechanism of genital infections)

AnnotationAssertion(rdfs:label X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections "Mechanism of genital infections"^^xsd:string)
ClassAssertion(OpenPVSignal:Adverse_Effect_Mechanism X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:genitalFungalInfections)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:genital_infection)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:mycoticBalanitis)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:mycoticVulvovaginitis)
ObjectPropertyAssertion(mp:references X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:Ref.2)
ObjectPropertyAssertion(mp:references X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:Ref.3)
ObjectPropertyAssertion(mp:references X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections X2017_m_sglt2_inhibitors_3rd:Ref.4)
DataPropertyAssertion(OpenPVSignal:has_content X2017_m_sglt2_inhibitors_3rd:Mechanism_of_genital_infections "Given their mechanism of action, one of the major safety concerns for the SLGT-2i is an increased risk of genital infections caused by high levels of glucose in the urine. This safety concern is common enough that it was observed in clinical trials and has been fairly well characterised. Genital infections are largely fungal in nature, manifesting as mycotic vulvovaginitis in females and mycotic balanitis in males. Such infections have been estimated to affect 5-10% of patients using SGLT-2i and are more common in premenopausal women, patients with a history of genital infections, and obese patients. There was no evidence of a relationship between the incidence of genital infections and the amount of glycosuria observed in the clinical trials. Furthermore, rates of infections are highest in the first few months of treatment.2-4"^^xsd:string)

# Individual: X2017_m_sglt2_inhibitors_3rd:No_causality_established_by_prior_clinical_trials_for_SGLT2_and_genital_infections (No causality established by prior clinical trials for SGLT2 and genital infections)

AnnotationAssertion(rdfs:label X2017_m_sglt2_inhibitors_3rd:No_causality_established_by_prior_clinical_trials_for_SGLT2_and_genital_infections "No causality established by prior clinical trials for SGLT2 and genital infections"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2017_m_sglt2_inhibitors_3rd:No_causality_established_by_prior_clinical_trials_for_SGLT2_and_genital_infections)
