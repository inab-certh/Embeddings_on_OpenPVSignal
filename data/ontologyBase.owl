AnnotationAssertion(rdfs:label OpenPVSignal:refers_to_partial_rechallenge_process "refers to partial rechallenge process"^^xsd:string)
SubDataPropertyOf(OpenPVSignal:refers_to_partial_rechallenge_process OpenPVSignal:refers_to_rechallenge_process)

# Data Property: OpenPVSignal:refers_to_rechallenge_outcome (refers to rechallenge outcome)

AnnotationAssertion(rdfs:comment OpenPVSignal:refers_to_rechallenge_outcome "Depicts the outcome of the rechallenge process applied to the respective adverse effect, as reported in the spontaneous report."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:refers_to_rechallenge_outcome "refers to rechallenge outcome"^^xsd:string)
SubDataPropertyOf(OpenPVSignal:refers_to_rechallenge_outcome owl:topDataProperty)
DataPropertyDomain(OpenPVSignal:refers_to_rechallenge_outcome OpenPVSignal:Individual_Case_Safety_Report)
DataPropertyDomain(OpenPVSignal:refers_to_rechallenge_outcome OpenPVSignal:Reports_group)
DataPropertyRange(OpenPVSignal:refers_to_rechallenge_outcome DataOneOf("death"^^xsd:string "hospitalization for treatment"^^xsd:string "irrelevant death"^^xsd:string "negative rechallenge - condition not appeared"^^xsd:string "permanent injury"^^xsd:string "positive rechallenge - condition appeared again"^^xsd:string "recovering"^^xsd:string "recovery after drug withdrawl"^^xsd:string "recovery after hospitalization"^^xsd:string "recovery with no further information"^^xsd:string "recovery with sequelae"^^xsd:string "recovery without drug withdrawl"^^xsd:string "unknown"^^xsd:string))

# Data Property: OpenPVSignal:refers_to_rechallenge_process (refers to rechallenge process)

AnnotationAssertion(rdfs:comment OpenPVSignal:refers_to_rechallenge_process "Depicts if the respective dosage is used as part of a rechallenge process."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:refers_to_rechallenge_process "refers to rechallenge process"^^xsd:string)
DataPropertyDomain(OpenPVSignal:refers_to_rechallenge_process OpenPVSignal:Dosage)
DataPropertyRange(OpenPVSignal:refers_to_rechallenge_process xsd:boolean)

# Data Property: OpenPVSignal:refers_to_signal_category (refers to signal category)

AnnotationAssertion(rdfs:comment OpenPVSignal:refers_to_signal_category "Refers to the the type of signal in question."^^xsd:string)
AnnotationAssertion(rdfs:label OpenPVSignal:refers_to_signal_category "refers to signal category"^^xsd:string)
SubDataPropertyOf(OpenPVSignal:refers_to_signal_category owl:topDataProperty)
DataPropertyRange(OpenPVSignal:refers_to_signal_category DataOneOf("Adverse drug reaction"^^xsd:string "Drug-drug interaction"^^xsd:string "Off-label use"^^xsd:string))

# Data Property: time:nominalPosition (Name of temporal position)

SubDataPropertyOf(time:nominalPosition owl:topDataProperty)

# Data Property: time:numericPosition (valor numérico de posición temporal)

SubDataPropertyOf(time:numericPosition owl:topDataProperty)



