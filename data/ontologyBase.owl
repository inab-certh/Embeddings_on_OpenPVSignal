ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:MolecularPharmacologyOfDPP4InhibitorsAffectingCardiacFunction X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.6)
