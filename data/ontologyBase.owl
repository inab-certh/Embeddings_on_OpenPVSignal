DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo11 "Case 11 reports unspecified heart disease"^^xsd:string)

# Individual: X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A (case info 8)

AnnotationAssertion(rdfs:label X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A "case info 8"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A "In case 8 (fatal outcome), a 66 year-old woman presented with HF 16 days after having started linagliptin. She was also treated with amlodipine 10 mg, quinapril 5 mg, bisoprolol 5 mg, gliquidone 30 mg, and simvastatin 20 mg."^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A "In case 8, concomitant diseases included renal artery stenosis, renal insufficiency, renal disease (shrinked kidneys), renal anaemia, renal osteodystrophy, hyperuricaemia, dyslipidaemia, hypertension, and chronic obstructive pulmonary diseases (COPD)"^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo8A "The fatal case (case 8) refers to a 66 year-old woman with renal insufficiency (renal artery stenosis, renal anaemia, renal dystrophia), hyperuricemia, dyslipemia, hypertension and COPD, who presented with acute dyspnoea and cardiac decompensation 16 days after having started therapy with linagliptin. The patient died 15 days later, and linagliptin was considered “implied”. "^^xsd:string)

# Individual: X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A (case info 9)

AnnotationAssertion(rdfs:label X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A "case info 9"^^xsd:string)
ClassAssertion(OpenPVSignal:Case_Report_Information X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A "Case 9 refers to a Japanese 87 year-old woman, weight 40 kg, treated with several drugs including nifedipine for hypertension, hyperlipidaemia, chronic renal failure and myocardial ischaemia.
The patient presented with congestive HF and aggravated renal failure six days after having started linagliptin 5 mg/day and nine days after start of cilostazol treatment with 200 mg/day"^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A "In case 9 (an 87 year-old woman treated with nifedipine and other cardiovascular therapies), cilostazol and linagliptin 5 mg had been added respectively nine days and five days before the HF onset."^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A "In case 9, cilostazol was started nine days before the adverse event and was also mentioned as a suspected drug. "^^xsd:string)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:caseInfo9A "In case 9, relevant medical history mentions cardiovascular disease (CVD) (percutaneous coronary intervention, angina pectoris and myocardial ischaemia), hypertension, hyperlipidaemia, chronic renal failure and diabetes mellitus."^^xsd:string)

