AnnotationAssertion(rdfs:label X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect "Thiazolidinediones confounding effect"^^xsd:string)
ClassAssertion(obo:OAE_0001182 X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect X2015_m_linagliptin_cardiac_failure_1st_2015:heartFailure)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect X2015_m_linagliptin_cardiac_failure_1st_2015:pioglitazone)
ObjectPropertyAssertion(mp:references X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect X2015_m_linagliptin_cardiac_failure_1st_2015:Ref.21)
DataPropertyAssertion(OpenPVSignal:has_content X2015_m_linagliptin_cardiac_failure_1st_2015:ThiazolidinedionesConfoundingEffect "For the patient treated with pioglitazone/ metformin (case 2), no time to onset was reported. Pioglitazone is a thiazolidinedione, which selectively ligands the nuclear transcription factor peroxisome proliferator-activated receptor-γ (PPAR-γ). Thiazolidinediones improve glycaemic control by increasing insulin sensitivity. Fluid retention, that can cause or exacerbate HF in some patients, is a known effect of PPAR-γ, and pioglitazone can cause or exacerbate congestive HF in some patients.21 "^^xsd:string)

