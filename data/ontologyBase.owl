# Individual: X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid (labelling for mycophenolic acid and tacrolimus)

AnnotationAssertion(rdfs:label X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid "labelling for mycophenolic acid and tacrolimus"^^xsd:string)
ClassAssertion(obo:OAE_0001197 X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid)
ClassAssertion(OpenPVSignal:Structured_Product_Labels_information X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid)
ClassAssertion(OpenPVSignal:Warning_Information X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid)
ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:DrugLevelIncreased)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:MycophenolicAcid)
ObjectPropertyAssertion(OpenPVSignal:refers_to_drug X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:Tacrolimus)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:Ref.11)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:Ref.12)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:Ref.13)
ObjectPropertyAssertion(mp:references X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid X2018_m_incosistent_labelling_4rth_2018:Ref.14)
DataPropertyAssertion(OpenPVSignal:has_content X2018_m_incosistent_labelling_4rth_2018:UK_SmPC_for_mycophenolic_acid "In the UK SmPC for mycophenolic acid, it is mentioned that the drug exposure of mycophenolic acid may increase when administered concurrently with tacrolimus (compared to when it is administered with ciclosporin).13 It is also stated that clinicians should note this increase and adjust the dose of mycophenolic acid according to the situation. However, the UK SmPC for tacrolimus does not mention this interaction.14 On the other hand, this interaction is given by the FDA for tacrolimus but not for mycophenolic acid.11,12"^^xsd:string)

