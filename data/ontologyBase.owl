ObjectPropertyAssertion(OpenPVSignal:refers_to_adverse_effect X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:HypersensitivityTriggeredByChlorhexidine X2015_m_Hexetidine_and_severe_hypersensitivity_1st_2015:hypersensitivity)
